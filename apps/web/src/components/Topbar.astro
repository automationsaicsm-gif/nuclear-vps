---
const languages = [
  { code: 'en', flag: '🇺🇸', label: 'English' },
  { code: 'es', flag: '🇪🇸', label: 'Español' },
  { code: 'fr', flag: '🇫🇷', label: 'Français' },
  { code: 'de', flag: '🇩🇪', label: 'Deutsch' },
  { code: 'it', flag: '🇮🇹', label: 'Italiano' },
  { code: 'pt', flag: '🇵🇹', label: 'Português' },
  { code: 'ru', flag: '🇷🇺', label: 'Русский' },
  { code: 'ar', flag: '🇸🇦', label: 'العربية' },
  { code: 'zh', flag: '🇨🇳', label: '中文' },
  { code: 'ja', flag: '🇯🇵', label: '日本語' },
  { code: 'ko', flag: '🇰🇷', label: '한국어' },
  { code: 'nl', flag: '🇳🇱', label: 'Nederlands' },
  { code: 'pl', flag: '🇵🇱', label: 'Polski' },
  { code: 'tr', flag: '🇹🇷', label: 'Türkçe' },
  { code: 'vi', flag: '🇻🇳', label: 'Tiếng Việt' },
  { code: 'th', flag: '🇹🇭', label: 'ภาษาไทย' },
  { code: 'id', flag: '🇮🇩', label: 'Bahasa Indonesia' },
  { code: 'ms', flag: '🇲🇾', label: 'Bahasa Melayu' },
  { code: 'sv', flag: '🇸🇪', label: 'Svenska' },
  { code: 'no', flag: '🇳🇴', label: 'Norsk' },
  { code: 'da', flag: '🇩🇰', label: 'Dansk' },
  { code: 'fi', flag: '🇫🇮', label: 'Suomi' },
  { code: 'ro', flag: '🇷🇴', label: 'Română' },
  { code: 'cs', flag: '🇨🇿', label: 'Čeština' },
  { code: 'hu', flag: '🇭🇺', label: 'Magyar' },
  { code: 'el', flag: '🇬🇷', label: 'Ελληνικά' },
];
---

<div class="bg-deep border-b border-[#312E81] py-2 px-4">
  <div class="max-w-7xl mx-auto flex items-center justify-between text-xs">
    <div class="flex items-center gap-2 text-text-body">
      <svg class="w-4 h-4 text-coral" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      <span>Live Support | Chat With an Expert!</span>
    </div>

    <div class="flex items-center gap-4">
      <a href="/blog" class="text-text-muted hover:text-coral transition-colors">Blogs</a>
      <a href="/dashboard/order" class="text-text-muted hover:text-coral transition-colors flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        View Cart
      </a>

      <div class="relative group">
        <button class="flex items-center gap-1 text-text-muted hover:text-coral transition-colors">
          🌐 Language
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute right-0 top-full mt-1 bg-surface border border-[#312E81] rounded-xl shadow-xl z-50 hidden group-hover:block w-48 max-h-64 overflow-y-auto">
          {languages.map((lang) => (
            <button
              data-lang={lang.code}
              class="lang-option w-full flex items-center gap-2 px-4 py-2 text-text-body hover:bg-deep hover:text-coral transition-colors text-left"
            >
              <span>{lang.flag}</span>
              <span>{lang.label}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.lang-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = (btn as HTMLElement).dataset.lang;
      if (lang) {
        localStorage.setItem('Nuclear VPS_language', lang);
        const url = new URL(window.location.href);
        url.searchParams.set('lang', lang);
        window.location.href = url.toString();
      }
    });
  });
</script>
