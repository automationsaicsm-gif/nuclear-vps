---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Services — Nuclear VPS">

  <div class="flex flex-col sm:flex-row gap-4 mb-6">
    <div class="relative flex-1 max-w-sm">
      <input id="svc-search" type="text" placeholder="Search by IP or user..."
        class="w-full bg-surface border border-[#312E81] rounded-xl px-4 py-2.5 pl-10 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors text-sm" />
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
    </div>
    <select id="status-filter" class="bg-surface border border-[#312E81] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral transition-colors text-sm">
      <option value="">All Statuses</option>
      <option value="ACTIVE">Active</option>
      <option value="PENDING">Pending</option>
      <option value="SUSPENDED">Suspended</option>
      <option value="TERMINATED">Terminated</option>
    </select>
    <select id="loc-filter" class="bg-surface border border-[#312E81] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral transition-colors text-sm">
      <option value="">All Locations</option>
      <option value="LONDON">🇬🇧 London</option>
      <option value="NEW_YORK">🇺🇸 New York</option>
    </select>
  </div>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-deep border-b border-[#312E81]">
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Service</th>
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Client</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Status</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Location</th>
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">IP Address</th>
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Due Date</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Actions</th>
          </tr>
        </thead>
        <tbody id="svc-table">
          <tr><td colspan="7" class="text-center py-10 text-text-muted">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    let allServices: any[] = [];

    function statusBadge(status: string) {
      const map: Record<string, string> = {
        ACTIVE: 'bg-green-500/10 text-green-400 border-green-500/30',
        PENDING: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
        SUSPENDED: 'bg-coral/10 text-coral border-coral/30',
        TERMINATED: 'bg-surface text-text-muted border-[#312E81]',
        CANCELLED: 'bg-surface text-text-muted border-[#312E81]',
      };
      return `<span class="inline-block px-2 py-0.5 rounded-full text-xs font-heading font-black border ${map[status] || map.PENDING}">${status}</span>`;
    }

    function render() {
      const q = (document.getElementById('svc-search') as HTMLInputElement).value.toLowerCase();
      const status = (document.getElementById('status-filter') as HTMLSelectElement).value;
      const loc = (document.getElementById('loc-filter') as HTMLSelectElement).value;
      const filtered = allServices.filter(s =>
        (!q || (s.ipAddress || '').includes(q) || `${s.user?.firstName} ${s.user?.lastName} ${s.user?.email}`.toLowerCase().includes(q)) &&
        (!status || s.status === status) &&
        (!loc || s.location === loc)
      );
      const tbody = document.getElementById('svc-table')!;
      if (!filtered.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-10 text-text-muted text-sm">No services found.</td></tr>';
        return;
      }
      tbody.innerHTML = filtered.map((s: any) => `
        <tr class="border-b border-[#312E81] hover:bg-surface transition-colors">
          <td class="px-5 py-4">
            <p class="font-heading font-bold text-text-h text-sm">${s.plan?.name || '—'}</p>
            <p class="text-text-muted text-xs">${s.billingCycle}</p>
          </td>
          <td class="px-5 py-4">
            <p class="text-text-body text-sm">${s.user?.firstName || ''} ${s.user?.lastName || ''}</p>
            <p class="text-text-muted text-xs">${s.user?.email || ''}</p>
          </td>
          <td class="px-5 py-4 text-center">${statusBadge(s.status)}</td>
          <td class="px-5 py-4 text-center text-text-body text-sm">${s.location === 'LONDON' ? '🇬🇧' : '🇺🇸'} ${s.location}</td>
          <td class="px-5 py-4 font-mono text-xs text-text-body">${s.ipAddress || '—'}</td>
          <td class="px-5 py-4 text-text-muted text-xs">${s.nextDueDate ? new Date(s.nextDueDate).toLocaleDateString() : '—'}</td>
          <td class="px-5 py-4 text-center">
            <select data-svc-id="${s.id}" class="bg-base border border-[#312E81] rounded-lg px-2 py-1 text-text-body text-xs focus:outline-none focus:border-coral" onchange="updateStatus(this)">
              <option value="">Set Status...</option>
              <option value="ACTIVE">Active</option>
              <option value="SUSPENDED">Suspended</option>
              <option value="TERMINATED">Terminated</option>
            </select>
          </td>
        </tr>
      `).join('');
    }

    (window as any).updateStatus = async (sel: HTMLSelectElement) => {
      const id = sel.getAttribute('data-svc-id')!;
      const status = sel.value;
      if (!status) return;
      await fetch(`/api/v1/admin/services/${id}`, {
        method: 'PUT', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status }),
      });
      sel.value = '';
      load();
    };

    ['svc-search', 'status-filter', 'loc-filter'].forEach(id => {
      document.getElementById(id)!.addEventListener('change', render);
      document.getElementById(id)!.addEventListener('input', render);
    });

    async function load() {
      try {
        const res = await fetch('/api/v1/admin/services', { credentials: 'include' });
        const json = await res.json();
        allServices = json.data?.services || [];
        render();
      } catch {
        document.getElementById('svc-table')!.innerHTML = '<tr><td colspan="7" class="text-center py-10 text-coral text-sm">Failed to load.</td></tr>';
      }
    }
    load();
  </script>
</AdminLayout>
