---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Dashboard — Nuclear VPS' } = Astro.props;

const navItems = [
  { href: '/dashboard', label: 'Dashboard', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { href: '/dashboard/services', label: 'My Services', icon: 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01' },
  { href: '/dashboard/order', label: 'Order New', icon: 'M12 4v16m8-8H4' },
  { href: '/dashboard/billing', label: 'Billing', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2' },
  { href: '/dashboard/tickets', label: 'Support', icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z' },
  { href: '/dashboard/affiliate', label: 'Affiliates', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { href: '/dashboard/account', label: 'Account', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' },
];

const currentPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-base text-text-body font-body min-h-screen flex">

  <!-- Sidebar -->
  <aside class="fixed left-0 top-0 bottom-0 w-64 bg-footer border-r border-[#312E81] flex flex-col z-30">
    <div class="p-6 border-b border-[#312E81]">
      <a href="/">
        <span class="font-heading font-black text-2xl text-text-h">NUCLEAR</span><span class="font-heading font-black text-2xl text-coral">VPS</span>
      </a>
    </div>

    <nav class="flex-1 p-4 overflow-y-auto">
      {navItems.map(({ href, label, icon }) => {
        const isActive = currentPath === href || (href !== '/dashboard' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            class={`flex items-center gap-3 px-4 py-3 rounded-xl mb-1 font-heading font-bold text-sm transition-all duration-200 ${
              isActive
                ? 'bg-indigo-mid text-white border-l-4 border-coral'
                : 'text-text-body hover:bg-surface hover:text-coral'
            }`}
          >
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icon}/>
            </svg>
            {label}
          </a>
        );
      })}
    </nav>

    <div class="p-4 border-t border-[#312E81]">
      <button id="dash-logout" class="w-full flex items-center gap-3 px-4 py-3 text-coral hover:bg-surface rounded-xl font-heading font-bold text-sm transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        Logout
      </button>
    </div>
  </aside>

  <!-- Main content -->
  <div class="ml-64 flex-1 flex flex-col min-h-screen">
    <!-- Top bar -->
    <header class="bg-footer border-b border-[#312E81] px-6 py-4 flex items-center justify-between sticky top-0 z-20">
      <h1 class="font-heading font-black text-text-h text-xl" id="page-title">{title.replace(' — Nuclear VPS', '')}</h1>
      <div class="flex items-center gap-4">
        <!-- Notification bell -->
        <div class="relative" id="notif-wrapper">
          <button id="notif-btn" class="relative text-text-muted hover:text-coral transition-colors focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
            </svg>
            <span id="notif-badge" class="hidden absolute -top-1 -right-1 w-4 h-4 bg-coral rounded-full text-white text-[10px] font-black flex items-center justify-center leading-none"></span>
          </button>
          <!-- Dropdown -->
          <div id="notif-dropdown" class="hidden absolute right-0 top-10 w-80 bg-footer border border-[#312E81] rounded-2xl shadow-xl z-50 overflow-hidden">
            <div class="px-4 py-3 border-b border-[#312E81] flex items-center justify-between">
              <p class="font-heading font-black text-text-h text-sm">Notifications</p>
              <button id="notif-clear" class="text-text-muted hover:text-coral text-xs font-heading font-bold transition-colors">Mark all read</button>
            </div>
            <div id="notif-list" class="max-h-72 overflow-y-auto divide-y divide-[#312E81]">
              <p class="text-text-muted text-sm p-4 text-center">Loading...</p>
            </div>
            <div class="px-4 py-3 border-t border-[#312E81] text-center">
              <a href="/dashboard/tickets" class="text-coral text-xs font-heading font-bold hover:underline">View all tickets</a>
            </div>
          </div>
        </div>
        <div class="w-9 h-9 rounded-full bg-indigo-mid flex items-center justify-center" id="dash-avatar">
          <span class="font-heading font-black text-coral text-sm" id="dash-initials">U</span>
        </div>
      </div>
    </header>

    <!-- Page content -->
    <main class="flex-1 p-6 bg-base">
      <slot />
    </main>
  </div>

  <script>
    // Auth guard
    const stored = localStorage.getItem('nuclear-vps-auth');
    if (!stored) {
      window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
    } else {
      try {
        const state = JSON.parse(stored);
        const user = state?.state?.user;
        if (!user) {
          window.location.href = '/login';
        } else if (user.role === 'ADMIN') {
          window.location.href = '/admin';
        } else {
          const initials = document.getElementById('dash-initials');
          if (initials) initials.textContent = (user.firstName?.[0] || '') + (user.lastName?.[0] || '');
        }
      } catch {
        window.location.href = '/login';
      }
    }

    document.getElementById('dash-logout')?.addEventListener('click', async () => {
      await fetch('/api/v1/auth/logout', { method: 'POST', credentials: 'include' });
      localStorage.removeItem('nuclear-vps-auth');
      window.location.href = '/';
    });

    // Notifications
    const notifBtn = document.getElementById('notif-btn')!;
    const notifDropdown = document.getElementById('notif-dropdown')!;
    const notifBadge = document.getElementById('notif-badge')!;
    const notifList = document.getElementById('notif-list')!;
    const notifClear = document.getElementById('notif-clear')!;

    // seenMap: { [ticketId]: ISO timestamp of last seen admin reply }
    // A ticket is "new" if its repliedAt is AFTER the stored timestamp
    let seenMap: Record<string, string> = JSON.parse(localStorage.getItem('notif-seen-v2') || '{}');

    function isNewNotif(ticket: any): boolean {
      const lastSeen = seenMap[ticket.id];
      if (!lastSeen) return true;
      return new Date(ticket.repliedAt) > new Date(lastSeen);
    }

    async function loadNotifications() {
      try {
        const res = await fetch('/api/v1/tickets/notifications', { credentials: 'include' });
        if (!res.ok) return;
        const json = await res.json();
        const tickets: any[] = json.data?.tickets || [];

        const newCount = tickets.filter(isNewNotif).length;

        if (newCount > 0) {
          notifBadge.textContent = newCount > 9 ? '9+' : String(newCount);
          notifBadge.classList.remove('hidden');
        } else {
          notifBadge.classList.add('hidden');
        }

        if (tickets.length === 0) {
          notifList.innerHTML = '<p class="text-text-muted text-sm p-4 text-center">No new notifications</p>';
          return;
        }

        notifList.innerHTML = tickets.map((t: any) => {
          const isNew = isNewNotif(t);
          const time = new Date(t.repliedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
          return `
            <a href="/dashboard/tickets/${t.id}" class="flex flex-col gap-1 px-4 py-3 hover:bg-surface transition-colors ${isNew ? 'border-l-2 border-coral' : ''}">
              <div class="flex items-center justify-between gap-2">
                <p class="font-heading font-bold text-text-h text-xs truncate">${t.subject}</p>
                ${isNew ? '<span class="shrink-0 w-2 h-2 rounded-full bg-coral"></span>' : ''}
              </div>
              <p class="text-text-muted text-xs truncate">Support: ${t.preview}</p>
              <p class="text-text-muted text-[11px]">${time}</p>
            </a>
          `;
        }).join('');
      } catch {}
    }

    notifBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      notifDropdown.classList.toggle('hidden');
      if (!notifDropdown.classList.contains('hidden')) loadNotifications();
    });

    notifClear.addEventListener('click', () => {
      fetch('/api/v1/tickets/notifications', { credentials: 'include' })
        .then(r => r.json())
        .then(json => {
          const tickets: any[] = json.data?.tickets || [];
          // Mark each ticket as seen at its current repliedAt timestamp
          tickets.forEach((t: any) => { seenMap[t.id] = t.repliedAt; });
          localStorage.setItem('notif-seen-v2', JSON.stringify(seenMap));
          notifBadge.classList.add('hidden');
          notifList.innerHTML = '<p class="text-text-muted text-sm p-4 text-center">No new notifications</p>';
        });
    });

    document.addEventListener('click', (e) => {
      if (!document.getElementById('notif-wrapper')!.contains(e.target as Node)) {
        notifDropdown.classList.add('hidden');
      }
    });

    // Poll every 15 seconds for faster notification delivery
    loadNotifications();
    setInterval(loadNotifications, 15000);
  </script>
</body>
</html>
