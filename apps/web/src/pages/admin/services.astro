---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Services — Nuclear VPS">

  <div class="flex flex-col sm:flex-row gap-4 mb-6 items-start">
    <button id="create-svc-btn" class="btn-primary text-sm px-5 py-2.5 shrink-0">+ Create Service</button>
    <div class="relative flex-1 max-w-sm">
      <input id="svc-search" type="text" placeholder="Search by IP or user..."
        class="w-full bg-surface border border-[#312E81] rounded-xl px-4 py-2.5 pl-10 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors text-sm" />
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
    </div>
    <select id="status-filter" class="bg-surface border border-[#312E81] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral transition-colors text-sm">
      <option value="">All Statuses</option>
      <option value="ACTIVE">Active</option>
      <option value="PENDING">Pending</option>
      <option value="SUSPENDED">Suspended</option>
      <option value="TERMINATED">Terminated</option>
    </select>
    <select id="loc-filter" class="bg-surface border border-[#312E81] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral transition-colors text-sm">
      <option value="">All Locations</option>
      <option value="LONDON">🇬🇧 London</option>
      <option value="NEW_YORK">🇺🇸 New York</option>
    </select>
  </div>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-deep border-b border-[#312E81]">
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Service</th>
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Client</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Status</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Location</th>
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">IP Address</th>
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Due Date</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Actions</th>
          </tr>
        </thead>
        <tbody id="svc-table">
          <tr><td colspan="7" class="text-center py-10 text-text-muted">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Create Service Modal -->
  <div id="create-svc-modal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
    <div class="bg-surface border border-[#312E81] rounded-2xl p-8 max-w-lg w-full">
      <h3 class="font-heading font-black text-text-h text-xl mb-6">Create Service</h3>
      <div id="cs-error" class="hidden mb-4 bg-coral/10 border border-coral/30 rounded-xl p-3 text-coral text-sm"></div>
      <form id="create-svc-form" class="space-y-4">
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">User Email</label>
          <input id="cs-email" type="email" placeholder="client@example.com" required class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm" />
        </div>
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Plan</label>
          <select id="cs-plan" required class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm">
            <option value="">Select plan...</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Billing Cycle</label>
            <select id="cs-billing" class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm">
              <option value="MONTHLY">Monthly</option>
              <option value="QUARTERLY">Quarterly</option>
              <option value="ANNUALLY">Annually</option>
            </select>
          </div>
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Location</label>
            <select id="cs-location" class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm">
              <option value="NEW_YORK">New York, US</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">IP Address</label>
            <input id="cs-ip" type="text" placeholder="192.168.1.1" class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm" />
          </div>
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Password</label>
            <input id="cs-pw" type="text" placeholder="VPS password" class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm" />
          </div>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" id="cs-cancel" class="btn-ghost flex-1 py-2.5">Cancel</button>
          <button type="submit" class="btn-primary flex-1 py-2.5">Create Service</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let allServices: any[] = [];

    function statusBadge(status: string) {
      const map: Record<string, string> = {
        ACTIVE: 'bg-green-500/10 text-green-400 border-green-500/30',
        PENDING: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
        SUSPENDED: 'bg-coral/10 text-coral border-coral/30',
        TERMINATED: 'bg-surface text-text-muted border-[#312E81]',
        CANCELLED: 'bg-surface text-text-muted border-[#312E81]',
      };
      return `<span class="inline-block px-2 py-0.5 rounded-full text-xs font-heading font-black border ${map[status] || map.PENDING}">${status}</span>`;
    }

    function render() {
      const q = (document.getElementById('svc-search') as HTMLInputElement).value.toLowerCase();
      const status = (document.getElementById('status-filter') as HTMLSelectElement).value;
      const loc = (document.getElementById('loc-filter') as HTMLSelectElement).value;
      const filtered = allServices.filter(s =>
        (!q || (s.ipAddress || '').includes(q) || `${s.user?.firstName} ${s.user?.lastName} ${s.user?.email}`.toLowerCase().includes(q)) &&
        (!status || s.status === status) &&
        (!loc || s.location === loc)
      );
      const tbody = document.getElementById('svc-table')!;
      if (!filtered.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-10 text-text-muted text-sm">No services found.</td></tr>';
        return;
      }
      tbody.innerHTML = filtered.map((s: any) => `
        <tr class="border-b border-[#312E81] hover:bg-surface transition-colors">
          <td class="px-5 py-4">
            <p class="font-heading font-bold text-text-h text-sm">${s.plan?.name || '—'}</p>
            <p class="text-text-muted text-xs">${s.billingCycle}</p>
          </td>
          <td class="px-5 py-4">
            <p class="text-text-body text-sm">${s.user?.firstName || ''} ${s.user?.lastName || ''}</p>
            <p class="text-text-muted text-xs">${s.user?.email || ''}</p>
          </td>
          <td class="px-5 py-4 text-center">${statusBadge(s.status)}</td>
          <td class="px-5 py-4 text-center text-text-body text-sm">${s.location === 'LONDON' ? '🇬🇧' : '🇺🇸'} ${s.location}</td>
          <td class="px-5 py-4 font-mono text-xs text-text-body">${s.ipAddress || '—'}</td>
          <td class="px-5 py-4 text-text-muted text-xs">${s.nextDueDate ? new Date(s.nextDueDate).toLocaleDateString() : '—'}</td>
          <td class="px-5 py-4 text-center">
            <div class="flex items-center justify-center gap-2">
              <select data-svc-id="${s.id}" class="bg-base border border-[#312E81] rounded-lg px-2 py-1 text-text-body text-xs focus:outline-none focus:border-coral" onchange="updateStatus(this)">
                <option value="">Status...</option>
                <option value="ACTIVE">Active</option>
                <option value="PENDING">Pending</option>
                <option value="SUSPENDED">Suspended</option>
              </select>
              ${s.status !== 'TERMINATED' ? `<button data-term="${s.id}" class="term-btn text-coral text-xs font-heading font-bold hover:underline">Terminate</button>` : ''}
            </div>
          </td>
        </tr>
      `).join('');
    }

    document.getElementById('svc-table')!.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('.term-btn') as HTMLElement | null;
      if (!btn) return;
      if (!confirm('Terminate this service? This cannot be undone.')) return;
      await fetch(`/api/v1/admin/services/${btn.getAttribute('data-term')}`, { method: 'DELETE', credentials: 'include' });
      load();
    });

    (window as any).updateStatus = async (sel: HTMLSelectElement) => {
      const id = sel.getAttribute('data-svc-id')!;
      const status = sel.value;
      if (!status) return;
      await fetch(`/api/v1/admin/services/${id}`, {
        method: 'PUT', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status }),
      });
      sel.value = '';
      load();
    };

    ['svc-search', 'status-filter', 'loc-filter'].forEach(id => {
      document.getElementById(id)!.addEventListener('change', render);
      document.getElementById(id)!.addEventListener('input', render);
    });

    async function load() {
      try {
        const res = await fetch('/api/v1/admin/services', { credentials: 'include' });
        const json = await res.json();
        allServices = json.data?.services || [];
        render();
      } catch {
        document.getElementById('svc-table')!.innerHTML = '<tr><td colspan="7" class="text-center py-10 text-coral text-sm">Failed to load.</td></tr>';
      }
    }
    load();

    // Create Service modal
    const createModal = document.getElementById('create-svc-modal')!;
    const csError = document.getElementById('cs-error')!;

    document.getElementById('create-svc-btn')!.addEventListener('click', async () => {
      csError.classList.add('hidden');
      createModal.classList.remove('hidden');
      // Populate plan select
      const planSel = document.getElementById('cs-plan') as HTMLSelectElement;
      if (planSel.options.length <= 1) {
        try {
          const r = await fetch('/api/v1/admin/plans', { credentials: 'include' });
          const j = await r.json();
          (j.data || []).forEach((p: any) => {
            const opt = document.createElement('option');
            opt.value = p.id;
            opt.textContent = `${p.name} ($${p.monthlyPrice}/mo)`;
            planSel.appendChild(opt);
          });
        } catch {}
      }
    });

    document.getElementById('cs-cancel')!.addEventListener('click', () => {
      createModal.classList.add('hidden');
      (document.getElementById('create-svc-form') as HTMLFormElement).reset();
    });

    createModal.addEventListener('click', (e) => {
      if (e.target === createModal) {
        createModal.classList.add('hidden');
        (document.getElementById('create-svc-form') as HTMLFormElement).reset();
      }
    });

    document.getElementById('create-svc-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      csError.classList.add('hidden');
      const email = (document.getElementById('cs-email') as HTMLInputElement).value.trim();
      const planId = (document.getElementById('cs-plan') as HTMLSelectElement).value;
      const billingCycle = (document.getElementById('cs-billing') as HTMLSelectElement).value;
      const location = (document.getElementById('cs-location') as HTMLSelectElement).value;
      const ipAddress = (document.getElementById('cs-ip') as HTMLInputElement).value.trim() || undefined;
      const password = (document.getElementById('cs-pw') as HTMLInputElement).value.trim() || undefined;

      try {
        // Look up user by email
        const ur = await fetch(`/api/v1/admin/users?search=${encodeURIComponent(email)}`, { credentials: 'include' });
        const uj = await ur.json();
        const users: any[] = uj.data?.users || [];
        const match = users.find((u: any) => u.email.toLowerCase() === email.toLowerCase());
        if (!match) throw new Error('No user found with that email.');

        const res = await fetch('/api/v1/admin/services', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: match.id, planId, billingCycle, location, ipAddress, password }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Failed to create service.');
        createModal.classList.add('hidden');
        (document.getElementById('create-svc-form') as HTMLFormElement).reset();
        load();
      } catch (err: any) {
        csError.textContent = err.message;
        csError.classList.remove('hidden');
      }
    });
  </script>
</AdminLayout>
