---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Plans — Nuclear VPS">

  <div class="card overflow-hidden">
    <div class="p-5 border-b border-[#312E81] flex items-center justify-between">
      <h2 class="font-heading font-black text-text-h">VPS & Server Plans</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-deep border-b border-[#312E81]">
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Plan</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Monthly</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Quarterly</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Annual</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Featured</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Available</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Actions</th>
          </tr>
        </thead>
        <tbody id="plans-table">
          <tr><td colspan="7" class="text-center py-10 text-text-muted">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Edit modal -->
  <div id="edit-modal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
    <div class="bg-surface border border-[#312E81] rounded-2xl p-8 max-w-lg w-full">
      <h3 class="font-heading font-black text-text-h text-xl mb-6" id="modal-plan-name">Edit Plan</h3>
      <div id="edit-plan-error" class="hidden mb-4 bg-coral/10 border border-coral/30 rounded-xl p-3 text-coral text-sm"></div>
      <form id="edit-plan-form" class="space-y-4">
        <input type="hidden" id="ep-id" />
        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Monthly ($)</label>
            <input id="ep-monthly" name="monthlyPrice" type="number" step="0.01" class="w-full bg-base border border-[#312E81] rounded-xl px-3 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm" />
          </div>
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Quarterly ($)</label>
            <input id="ep-quarterly" name="quarterlyPrice" type="number" step="0.01" class="w-full bg-base border border-[#312E81] rounded-xl px-3 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm" />
          </div>
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Annual ($)</label>
            <input id="ep-annual" name="annualPrice" type="number" step="0.01" class="w-full bg-base border border-[#312E81] rounded-xl px-3 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm" />
          </div>
        </div>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <input id="ep-featured" name="featured" type="checkbox" class="w-4 h-4 accent-coral" />
            <span class="text-text-body text-sm font-heading font-bold">Featured (Most Popular)</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input id="ep-available" name="available" type="checkbox" class="w-4 h-4 accent-coral" />
            <span class="text-text-body text-sm font-heading font-bold">Available for Purchase</span>
          </label>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" id="cancel-plan-edit" class="btn-ghost flex-1 py-2.5">Cancel</button>
          <button type="submit" class="btn-primary flex-1 py-2.5">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let plans: any[] = [];

    function toggle(val: boolean) {
      return val
        ? '<span class="inline-block w-2 h-2 rounded-full bg-green-400"></span>'
        : '<span class="inline-block w-2 h-2 rounded-full bg-surface border border-[#312E81]"></span>';
    }

    function render() {
      const tbody = document.getElementById('plans-table')!;
      if (!plans.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-10 text-text-muted text-sm">No plans found.</td></tr>';
        return;
      }
      tbody.innerHTML = plans.map((p: any) => `
        <tr class="border-b border-[#312E81] hover:bg-surface transition-colors">
          <td class="px-5 py-4">
            <p class="font-heading font-black text-text-h text-sm">${p.name}</p>
            <p class="text-text-muted text-xs">${p.category}</p>
          </td>
          <td class="px-5 py-4 text-center text-coral font-heading font-black">$${p.monthlyPrice}</td>
          <td class="px-5 py-4 text-center text-text-body text-sm">$${p.quarterlyPrice}</td>
          <td class="px-5 py-4 text-center text-text-body text-sm">$${p.annualPrice}</td>
          <td class="px-5 py-4 text-center">${toggle(p.featured)}</td>
          <td class="px-5 py-4 text-center">${toggle(p.available)}</td>
          <td class="px-5 py-4 text-center">
            <button data-plan='${JSON.stringify(p)}' class="edit-plan text-coral text-xs font-heading font-bold hover:underline">Edit</button>
          </td>
        </tr>
      `).join('');

      document.querySelectorAll('.edit-plan').forEach(btn => {
        btn.addEventListener('click', () => {
          const p = JSON.parse(btn.getAttribute('data-plan')!);
          document.getElementById('modal-plan-name')!.textContent = `Edit: ${p.name}`;
          (document.getElementById('ep-id') as HTMLInputElement).value = p.id;
          (document.getElementById('ep-monthly') as HTMLInputElement).value = p.monthlyPrice;
          (document.getElementById('ep-quarterly') as HTMLInputElement).value = p.quarterlyPrice;
          (document.getElementById('ep-annual') as HTMLInputElement).value = p.annualPrice;
          (document.getElementById('ep-featured') as HTMLInputElement).checked = p.featured;
          (document.getElementById('ep-available') as HTMLInputElement).checked = p.available;
          document.getElementById('edit-modal')!.classList.remove('hidden');
        });
      });
    }

    document.getElementById('cancel-plan-edit')!.addEventListener('click', () => {
      document.getElementById('edit-modal')!.classList.add('hidden');
    });

    document.getElementById('edit-plan-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = (document.getElementById('ep-id') as HTMLInputElement).value;
      const errEl = document.getElementById('edit-plan-error')!;
      errEl.classList.add('hidden');
      try {
        const res = await fetch(`/api/v1/admin/plans/${id}`, {
          method: 'PUT', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            monthlyPrice: parseFloat((document.getElementById('ep-monthly') as HTMLInputElement).value),
            quarterlyPrice: parseFloat((document.getElementById('ep-quarterly') as HTMLInputElement).value),
            annualPrice: parseFloat((document.getElementById('ep-annual') as HTMLInputElement).value),
            featured: (document.getElementById('ep-featured') as HTMLInputElement).checked,
            available: (document.getElementById('ep-available') as HTMLInputElement).checked,
          }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error);
        document.getElementById('edit-modal')!.classList.add('hidden');
        load();
      } catch (err: any) {
        errEl.textContent = err.message;
        errEl.classList.remove('hidden');
      }
    });

    async function load() {
      try {
        const res = await fetch('/api/v1/admin/plans', { credentials: 'include' });
        const json = await res.json();
        plans = json.data?.plans || [];
        render();
      } catch {
        document.getElementById('plans-table')!.innerHTML = '<tr><td colspan="7" class="text-center py-10 text-coral text-sm">Failed to load.</td></tr>';
      }
    }
    load();
  </script>
</AdminLayout>
