---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Trading VPS — Nuclear VPS" description="High performance Trading VPS optimized for Forex and algorithmic trading. Ultra-low latency, 99.9% uptime, Windows-based.">

  <!-- Hero -->
  <section class="bg-hero relative overflow-hidden py-20 lg:py-32">
    <div class="absolute top-0 left-0 w-96 h-96 rounded-full opacity-10" style="background:radial-gradient(circle,#1E3FA0,transparent);transform:translate(-30%,-30%)"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 rounded-full opacity-10" style="background:radial-gradient(circle,#2D55C8,transparent);transform:translate(30%,30%)"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-2 mb-6">
        <span class="text-white text-sm font-heading font-bold">⚡ Optimized for Traders</span>
      </div>
      <h1 class="font-heading font-black text-4xl lg:text-6xl text-white mb-6">
        Trading <span class="text-blue-200">VPS</span>
      </h1>
      <p class="text-blue-100 text-xl mb-10 max-w-2xl mx-auto leading-relaxed">
        Virtual Private Servers built from the ground up for algorithmic traders. Run your Expert Advisors 24/7 without downtime.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#pricing" class="bg-white text-[#1A3A8F] font-heading font-black text-lg px-8 py-4 rounded-full hover:bg-blue-50 transition-all duration-200">View Plans & Pricing</a>
        <a href="/forex-broker-latency" class="border-2 border-white text-white hover:bg-white/10 font-heading font-bold text-lg px-8 py-4 rounded-full transition-all duration-200">Check Broker Latency</a>
      </div>
    </div>
  </section>

  <!-- Pricing (VPS only - static inline version) -->
  <section id="pricing" class="bg-base py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="section-tag mb-3">TRADING VPS PLANS</p>
        <h2 class="font-heading font-black text-4xl lg:text-5xl text-text-h mb-4">Choose Your Perfect Plan</h2>
        <p class="text-text-muted text-lg">High performance VPS optimized for Forex and algorithmic trading</p>
      </div>

      <!-- Billing cycle switcher -->
      <div class="flex justify-center mb-12">
        <div class="flex bg-deep border border-[#E5E7EB] rounded-full p-1 gap-1" id="cycle-tabs">
          <button data-cycle="monthly" class="cycle-btn active px-5 py-2 rounded-full font-heading font-bold text-sm transition-all duration-200 bg-coral text-white">Monthly</button>
          <button data-cycle="quarterly" class="cycle-btn px-5 py-2 rounded-full font-heading font-bold text-sm transition-all duration-200 text-text-muted hover:text-text-body">Quarterly (Save 6%)</button>
          <button data-cycle="annually" class="cycle-btn px-5 py-2 rounded-full font-heading font-bold text-sm transition-all duration-200 text-text-muted hover:text-text-body">1-Year (Save 17%)</button>
        </div>
      </div>

      <!-- Plan cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="vps-plans">
        <!-- Bronze VPS -->
        <div class="relative bg-surface border border-[#E5E7EB] rounded-2xl p-8 hover:shadow-[0_0_0_1px_#2D55C8] transition-all duration-200">
          <h3 class="font-heading font-black text-text-h text-xl mb-2">Bronze VPS</h3>
          <div class="mb-1"><span class="text-text-muted line-through text-sm plan-original">$24.9/mo</span></div>
          <div class="flex items-end gap-1 mb-4">
            <span class="text-coral font-heading font-black text-4xl plan-price" data-monthly="24.9" data-quarterly="23.45" data-annually="20.75">$24.9</span>
            <span class="text-text-muted text-sm mb-1">/month</span>
          </div>
          <div class="border-t border-[#E5E7EB] my-4"></div>
          <ul class="space-y-3 mb-8">
            {['2 GB DDR5 RAM', '2 GHz CPU', '30 GB NVMe SSD', 'Windows 2022 / 2019 / 2016', 'Trading Optimized', 'Up to 3 Platforms'].map((f) => (
              <li class="flex items-center gap-2 text-text-body text-sm">
                <div class="w-4 h-4 rounded-full bg-coral/20 flex items-center justify-center shrink-0">
                  <div class="w-1.5 h-1.5 rounded-full bg-coral"></div>
                </div>
                {f}
              </li>
            ))}
          </ul>
          <a href="/register?redirect=/dashboard/order&plan=bronze-vps" class="block w-full bg-coral hover:bg-coral-dark text-white font-heading font-black py-3 rounded-xl transition-all duration-200 text-center">Order Now</a>
        </div>

        <!-- Silver VPS (featured) -->
        <div class="relative bg-surface border-2 border-coral rounded-2xl p-8 hover:shadow-[0_0_0_1px_#2D55C8] transition-all duration-200">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2">
            <span class="bg-coral text-white font-heading font-bold text-xs px-4 py-1 rounded-full">Most Popular</span>
          </div>
          <h3 class="font-heading font-black text-text-h text-xl mb-2">Silver VPS</h3>
          <div class="mb-1"><span class="text-text-muted line-through text-sm plan-original">$48.9/mo</span></div>
          <div class="flex items-end gap-1 mb-4">
            <span class="text-coral font-heading font-black text-4xl plan-price" data-monthly="48.9" data-quarterly="45.97" data-annually="40.75">$48.9</span>
            <span class="text-text-muted text-sm mb-1">/month</span>
          </div>
          <div class="border-t border-[#E5E7EB] my-4"></div>
          <ul class="space-y-3 mb-8">
            {['4 GB DDR5 RAM', '3 GHz CPU', '50 GB NVMe SSD', 'Windows 2022 / 2019 / 2016', 'Trading Optimized', 'Up to 6 Platforms'].map((f) => (
              <li class="flex items-center gap-2 text-text-body text-sm">
                <div class="w-4 h-4 rounded-full bg-coral/20 flex items-center justify-center shrink-0">
                  <div class="w-1.5 h-1.5 rounded-full bg-coral"></div>
                </div>
                {f}
              </li>
            ))}
          </ul>
          <a href="/register?redirect=/dashboard/order&plan=silver-vps" class="block w-full bg-coral hover:bg-coral-dark text-white font-heading font-black py-3 rounded-xl transition-all duration-200 text-center">Order Now</a>
        </div>

        <!-- Gold VPS -->
        <div class="relative bg-surface border border-[#E5E7EB] rounded-2xl p-8 hover:shadow-[0_0_0_1px_#2D55C8] transition-all duration-200">
          <h3 class="font-heading font-black text-text-h text-xl mb-2">Gold VPS</h3>
          <div class="mb-1"><span class="text-text-muted line-through text-sm plan-original">$74.9/mo</span></div>
          <div class="flex items-end gap-1 mb-4">
            <span class="text-coral font-heading font-black text-4xl plan-price" data-monthly="74.9" data-quarterly="70.41" data-annually="62.5">$74.9</span>
            <span class="text-text-muted text-sm mb-1">/month</span>
          </div>
          <div class="border-t border-[#E5E7EB] my-4"></div>
          <ul class="space-y-3 mb-8">
            {['6 GB DDR5 RAM', '4 GHz CPU', '75 GB NVMe SSD', 'Windows 2022 / 2019 / 2016', 'Trading Optimized', 'Up to 10 Platforms'].map((f) => (
              <li class="flex items-center gap-2 text-text-body text-sm">
                <div class="w-4 h-4 rounded-full bg-coral/20 flex items-center justify-center shrink-0">
                  <div class="w-1.5 h-1.5 rounded-full bg-coral"></div>
                </div>
                {f}
              </li>
            ))}
          </ul>
          <a href="/register?redirect=/dashboard/order&plan=gold-vps" class="block w-full bg-coral hover:bg-coral-dark text-white font-heading font-black py-3 rounded-xl transition-all duration-200 text-center">Order Now</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Included With Every Plan -->
  <section class="bg-surface py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="section-tag mb-3">WHAT'S INCLUDED</p>
        <h2 class="font-heading font-black text-4xl text-text-h mb-4">Included With Every Plan</h2>
        <p class="text-text-muted text-lg">Every Nuclear VPS comes packed with features to give you the edge</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          'Fully Managed Windows VPS',
          '99.9% Uptime Guarantee',
          '24/7 Live Human Support',
          'Instant Setup & Activation',
          'Ultra-Low Latency Network',
          'Daily Automated Backups',
          'RDP Remote Access',
          'MT4 / MT5 Pre-configured',
          'cTrader Compatible',
          'DDoS Protection Included',
          'SSD NVMe Storage',
          'Instant Provisioning',
          'Multiple Trading Platforms',
          'Global Data Center Options',
          'Free Migration Assistance',
          'Redundant Infrastructure',
        ].map((feature) => (
          <div class="flex items-center gap-3 bg-base border border-[#E5E7EB] rounded-xl px-4 py-3">
            <div class="w-5 h-5 rounded-full bg-coral flex items-center justify-center shrink-0">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <span class="text-text-body text-sm">{feature}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pay As You Grow -->
  <section class="bg-base py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-hero border border-[#1E3FA0] rounded-3xl p-10 text-center relative overflow-hidden">
        <div class="absolute inset-0 opacity-10" style="background:radial-gradient(circle at 50% 0%, #2D55C8, transparent 70%)"></div>
        <div class="relative z-10">
          <span class="text-blue-300 text-xs font-heading font-black tracking-widest uppercase mb-4 block">FLEXIBLE SCALING</span>
          <h2 class="font-heading font-black text-3xl lg:text-4xl text-white mb-4">Pay As You Grow</h2>
          <p class="text-blue-100 text-lg mb-8 leading-relaxed max-w-2xl mx-auto">
            Start small and upgrade anytime — no contracts, no penalties. As your trading operation scales, your VPS scales with it. Upgrade from Bronze to Silver or Gold in seconds, right from your dashboard.
          </p>
          <div class="flex flex-wrap justify-center gap-6 mb-10">
            {[
              { label: 'Instant Upgrades', desc: 'Upgrade without downtime' },
              { label: 'No Lock-in', desc: 'Cancel anytime, no penalty' },
              { label: 'Pro-rated Billing', desc: 'Only pay for what you use' },
            ].map(({ label, desc }) => (
              <div class="text-center">
                <div class="font-heading font-black text-blue-200 text-lg mb-1">{label}</div>
                <div class="text-blue-200/70 text-sm">{desc}</div>
              </div>
            ))}
          </div>
          <a href="/register" class="btn-primary text-lg px-10 py-4">Start Your Journey</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-surface py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-tag mb-3">COMMON QUESTIONS</p>
        <h2 class="font-heading font-black text-4xl text-text-h">Frequently Asked Questions</h2>
      </div>
      <div class="space-y-3" id="faq-container">
        {[
          { q: 'What is a Trading VPS?', a: 'A Trading VPS is a constantly powered-on virtual Windows server connected to the internet 24/7. Install MetaTrader, cTrader, or any trading platform and run Expert Advisors and automated systems without interruption — even when your computer is off.' },
          { q: 'How quickly will I get access?', a: 'Instantly. Your VPS is provisioned automatically within minutes of payment. Windows installation may take up to 10 minutes. Login credentials are sent directly to your email — check your spam folder if you do not see it.' },
          { q: 'Which trading platforms are supported?', a: 'All major platforms are supported: MetaTrader 4, MetaTrader 5, cTrader, NinjaTrader, TradeStation, and any Windows-compatible trading software. Our VPS ships with nothing pre-installed so you are free to configure as you wish.' },
          { q: 'Where is your data center located?', a: 'Our data center is located in New York, US — one of the world\'s primary Forex trading hubs. This ensures ultra-low latency to most major Forex brokers. Check our Broker Latency page for exact ping times to your specific broker.' },
          { q: 'Can I upgrade my plan later?', a: 'Absolutely. You can upgrade from any plan to a higher tier at any time directly from your dashboard. Upgrades are applied instantly with no downtime and billing is pro-rated for the remaining period.' },
          { q: 'What operating systems are available?', a: 'All VPS plans include Windows Server 2022, 2019, or 2016. These are the most compatible operating systems for trading platforms. Linux VPS is available on dedicated server plans.' },
        ].map((faq, i) => (
          <div class="faq-item border border-[#E5E7EB] rounded-xl overflow-hidden transition-all duration-200">
            <button class="faq-btn w-full flex items-center justify-between px-6 py-4 text-left bg-base hover:bg-deep/50 transition-colors" data-index={i}>
              <span class="font-heading font-bold text-text-h">{faq.q}</span>
              <svg class="faq-icon w-5 h-5 text-coral shrink-0 ml-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-content hidden bg-deep px-6 py-4">
              <p class="text-text-body leading-relaxed">{faq.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-hero py-20 text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading font-black text-4xl text-white mb-4">Ready to Trade Without Limits?</h2>
      <p class="text-blue-100 text-lg mb-8 leading-relaxed">
        Join thousands of traders already running their EAs on Nuclear VPS. Ultra-low latency, 99.9% uptime, and 24/7 expert support.
      </p>
      <a href="#pricing" class="bg-white text-[#1A3A8F] font-heading font-black text-lg px-10 py-4 rounded-full hover:bg-blue-50 transition-all duration-200">Get Started Now</a>
    </div>
  </section>

</BaseLayout>

<script>
  // FAQ accordion
  document.querySelectorAll('.faq-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item') as HTMLElement;
      const content = item.querySelector('.faq-content') as HTMLElement;
      const icon = btn.querySelector('.faq-icon') as HTMLElement;
      const isOpen = !content.classList.contains('hidden');

      // Close all
      document.querySelectorAll('.faq-item').forEach((el) => {
        (el.querySelector('.faq-content') as HTMLElement).classList.add('hidden');
        (el.querySelector('.faq-icon') as HTMLElement).classList.remove('rotate-180');
        (el.querySelector('.faq-btn') as HTMLElement).classList.remove('bg-deep');
        (el.querySelector('.faq-btn') as HTMLElement).classList.add('bg-base');
        (el as HTMLElement).style.borderColor = '';
      });

      if (!isOpen) {
        content.classList.remove('hidden');
        icon.classList.add('rotate-180');
        btn.classList.add('bg-deep');
        btn.classList.remove('bg-base');
        item.style.borderColor = '#2D55C8';
      }
    });
  });

  // Billing cycle switcher
  const prices: Record<string, Record<string, number>> = {
    monthly: { bronze: 24.9, silver: 48.9, gold: 74.9 },
    quarterly: { bronze: 23.45, silver: 45.97, gold: 70.41 },
    annually: { bronze: 20.75, silver: 40.75, gold: 62.5 },
  };

  document.querySelectorAll('.cycle-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cycle = (btn as HTMLElement).dataset.cycle as string;

      document.querySelectorAll('.cycle-btn').forEach((b) => {
        b.classList.remove('bg-coral', 'text-white');
        b.classList.add('text-text-muted');
      });
      btn.classList.add('bg-coral', 'text-white');
      btn.classList.remove('text-text-muted');

      document.querySelectorAll('.plan-price').forEach((el) => {
        const price = (el as HTMLElement).dataset[cycle as string];
        if (price) el.textContent = `$${price}`;
      });
    });
  });
</script>
