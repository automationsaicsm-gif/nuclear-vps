---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Broadcast — Nuclear VPS">

  <div class="max-w-2xl mx-auto">
    <div class="card p-8">
      <h2 class="font-heading font-black text-text-h text-xl mb-2">Email Broadcast</h2>
      <p class="text-text-muted text-sm mb-6">Send a message to all users or a filtered group.</p>

      <div id="bc-error" class="hidden mb-4 bg-coral/10 border border-coral/30 rounded-xl p-3 text-coral text-sm"></div>
      <div id="bc-success" class="hidden mb-4 bg-green-500/10 border border-green-500/30 rounded-xl p-3 text-green-400 text-sm"></div>

      <form id="broadcast-form" class="space-y-5">
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Audience</label>
          <select id="bc-audience" class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm">
            <option value="ALL">All Users</option>
            <option value="ACTIVE">Users with Active Services</option>
            <option value="UNPAID">Users with Unpaid Invoices</option>
          </select>
        </div>
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Subject</label>
          <input id="bc-subject" type="text" required placeholder="Important update from Nuclear VPS"
            class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-2.5 text-text-h placeholder-text-muted focus:outline-none focus:border-coral text-sm" />
        </div>
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Message</label>
          <textarea id="bc-message" rows="8" required placeholder="Write your message here..."
            class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-3 text-text-h placeholder-text-muted focus:outline-none focus:border-coral text-sm resize-none"></textarea>
        </div>
        <div class="flex items-center gap-4 pt-2">
          <button type="submit" id="bc-submit" class="btn-primary px-8 py-2.5 text-sm">Send Broadcast</button>
          <p class="text-text-muted text-xs" id="bc-recipient-count"></p>
        </div>
      </form>
    </div>

    <!-- Sent history -->
    <div class="card overflow-hidden mt-8">
      <div class="p-5 border-b border-[#E5E7EB]">
        <h3 class="font-heading font-black text-text-h">Recent Broadcasts</h3>
      </div>
      <div id="broadcast-history" class="divide-y divide-[#E5E7EB]">
        <p class="text-text-muted text-sm p-5">Loading...</p>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('bc-audience')!.addEventListener('change', updateCount);

    async function updateCount() {
      const audience = (document.getElementById('bc-audience') as HTMLSelectElement).value;
      try {
        const res = await fetch(`/api/v1/admin/broadcast?audience=${audience}`, { credentials: 'include' });
        const json = await res.json();
        document.getElementById('bc-recipient-count')!.textContent = `~${json.data?.count || 0} recipients`;
      } catch {}
    }
    updateCount();

    document.getElementById('broadcast-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errEl = document.getElementById('bc-error')!;
      const sucEl = document.getElementById('bc-success')!;
      const btn = document.getElementById('bc-submit') as HTMLButtonElement;
      errEl.classList.add('hidden');
      sucEl.classList.add('hidden');
      btn.disabled = true;
      btn.textContent = 'Sending...';

      try {
        const res = await fetch('/api/v1/admin/broadcast', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            audience: (document.getElementById('bc-audience') as HTMLSelectElement).value,
            subject: (document.getElementById('bc-subject') as HTMLInputElement).value.trim(),
            message: (document.getElementById('bc-message') as HTMLTextAreaElement).value.trim(),
          }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Failed to send.');
        sucEl.textContent = `Broadcast sent to ${json.data?.sent || 0} users.`;
        sucEl.classList.remove('hidden');
        (document.getElementById('broadcast-form') as HTMLFormElement).reset();
        loadHistory();
      } catch (err: any) {
        errEl.textContent = err.message;
        errEl.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Send Broadcast';
      }
    });

    async function loadHistory() {
      try {
        const res = await fetch('/api/v1/admin/audit-log?action=BROADCAST&limit=10', { credentials: 'include' });
        const json = await res.json();
        const logs: any[] = json.data?.logs || [];
        const el = document.getElementById('broadcast-history')!;
        if (!logs.length) {
          el.innerHTML = '<p class="text-text-muted text-sm p-5">No broadcasts sent yet.</p>';
          return;
        }
        el.innerHTML = logs.map(l => `
          <div class="px-5 py-3">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-text-body text-sm font-heading font-bold">${l.details || 'Broadcast'}</p>
                <p class="text-text-muted text-xs mt-0.5">by ${l.adminEmail}</p>
              </div>
              <p class="text-text-muted text-xs">${new Date(l.createdAt).toLocaleString()}</p>
            </div>
          </div>
        `).join('');
      } catch {}
    }
    loadHistory();
  </script>
</AdminLayout>
