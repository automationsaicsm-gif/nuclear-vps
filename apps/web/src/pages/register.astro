---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Create Account — Nuclear VPS" description="Sign up for a Nuclear VPS hosting account.">
  <section class="min-h-[80vh] flex items-center justify-center py-20 px-4">
    <div class="w-full max-w-2xl">
      <div class="text-center mb-10">
        <a href="/" class="inline-block mb-8">
          <span class="font-heading font-black text-3xl text-text-h">NUCLEAR</span><span class="font-heading font-black text-3xl text-coral">VPS</span>
        </a>
        <h1 class="font-heading font-black text-3xl text-text-h mb-2">Create Your Account</h1>
        <p class="text-text-muted">Start with a 7-day money-back guarantee</p>
      </div>

      <div class="bg-surface border border-[#312E81] rounded-2xl p-8">
        <div id="reg-error" class="hidden mb-6 bg-coral/10 border border-coral/30 rounded-xl p-4 text-coral text-sm"></div>
        <div id="reg-success" class="hidden mb-6 bg-green-500/10 border border-green-500/30 rounded-xl p-4 text-green-400 text-sm"></div>

        <form id="reg-form" class="space-y-5">
          <!-- Name row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-text-body text-sm font-heading font-bold mb-2" for="firstName">First Name</label>
              <input id="firstName" name="firstName" type="text" required
                class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors"
                placeholder="John" />
            </div>
            <div>
              <label class="block text-text-body text-sm font-heading font-bold mb-2" for="lastName">Last Name</label>
              <input id="lastName" name="lastName" type="text" required
                class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors"
                placeholder="Doe" />
            </div>
          </div>

          <!-- Email -->
          <div>
            <label class="block text-text-body text-sm font-heading font-bold mb-2" for="email">Email Address</label>
            <input id="email" name="email" type="email" required autocomplete="email"
              class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors"
              placeholder="you@example.com" />
          </div>

          <!-- Password row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-text-body text-sm font-heading font-bold mb-2" for="password">Password</label>
              <input id="password" name="password" type="password" required minlength="8"
                class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors"
                placeholder="Min 8 characters" />
            </div>
            <div>
              <label class="block text-text-body text-sm font-heading font-bold mb-2" for="confirmPassword">Confirm Password</label>
              <input id="confirmPassword" name="confirmPassword" type="password" required
                class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors"
                placeholder="Repeat password" />
            </div>
          </div>

          <!-- Country -->
          <div>
            <label class="block text-text-body text-sm font-heading font-bold mb-2" for="country">Country</label>
            <select id="country" name="country" required
              class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors">
              <option value="">Select your country</option>
              <option value="US">United States</option>
              <option value="GB">United Kingdom</option>
              <option value="CA">Canada</option>
              <option value="AU">Australia</option>
              <option value="DE">Germany</option>
              <option value="FR">France</option>
              <option value="JP">Japan</option>
              <option value="SG">Singapore</option>
              <option value="AE">United Arab Emirates</option>
              <option value="ZA">South Africa</option>
              <option value="NG">Nigeria</option>
              <option value="IN">India</option>
              <option value="BR">Brazil</option>
              <option value="MX">Mexico</option>
              <option value="NL">Netherlands</option>
              <option value="SE">Sweden</option>
              <option value="CH">Switzerland</option>
              <option value="NZ">New Zealand</option>
              <option value="HK">Hong Kong</option>
              <option value="OTHER">Other</option>
            </select>
          </div>

          <!-- Optional fields -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-text-body text-sm font-heading font-bold mb-2" for="phone">Phone <span class="text-text-muted font-normal">(optional)</span></label>
              <input id="phone" name="phone" type="tel"
                class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors"
                placeholder="+1 555 000 0000" />
            </div>
            <div>
              <label class="block text-text-body text-sm font-heading font-bold mb-2" for="company">Company <span class="text-text-muted font-normal">(optional)</span></label>
              <input id="company" name="company" type="text"
                class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors"
                placeholder="Your company" />
            </div>
          </div>

          <!-- Terms -->
          <div>
            <label class="flex items-start gap-3 cursor-pointer">
              <input id="terms" name="terms" type="checkbox" required
                class="w-4 h-4 mt-1 rounded border-[#312E81] bg-base accent-coral shrink-0" />
              <span class="text-text-muted text-sm leading-relaxed">
                I agree to the
                <a href="/terms" class="text-coral hover:underline">Terms & Conditions</a>
                and
                <a href="/privacy" class="text-coral hover:underline">Privacy Policy</a>
              </span>
            </label>
          </div>

          <button type="submit" id="reg-btn"
            class="w-full btn-primary py-3 text-base flex items-center justify-center gap-2">
            <span id="reg-btn-text">Create Account</span>
            <svg id="reg-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
            </svg>
          </button>
        </form>

        <p class="text-center text-text-muted text-sm mt-6">
          Already have an account?
          <a href="/login" class="text-coral font-heading font-bold hover:underline ml-1">Sign in</a>
        </p>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('reg-form') as HTMLFormElement;
    const errorBox = document.getElementById('reg-error')!;
    const successBox = document.getElementById('reg-success')!;
    const btn = document.getElementById('reg-btn') as HTMLButtonElement;
    const btnText = document.getElementById('reg-btn-text')!;
    const spinner = document.getElementById('reg-spinner')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      successBox.classList.add('hidden');

      const data = Object.fromEntries(new FormData(form));

      if (data.password !== data.confirmPassword) {
        errorBox.textContent = 'Passwords do not match.';
        errorBox.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      btnText.textContent = 'Creating account...';
      spinner.classList.remove('hidden');

      try {
        const res = await fetch('/api/v1/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({
            firstName: data.firstName,
            lastName: data.lastName,
            email: data.email,
            password: data.password,
            country: data.country,
            phone: data.phone || undefined,
            company: data.company || undefined,
          }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Registration failed');

        localStorage.setItem('nuclear-vps-auth', JSON.stringify({ state: { user: json.data.user } }));

        const params = new URLSearchParams(window.location.search);
        window.location.href = params.get('redirect') || '/dashboard';
      } catch (err: any) {
        errorBox.textContent = err.message;
        errorBox.classList.remove('hidden');
        btn.disabled = false;
        btnText.textContent = 'Create Account';
        spinner.classList.add('hidden');
      }
    });
  </script>
</BaseLayout>
