---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Audit Log — Nuclear VPS">

  <div class="flex flex-col sm:flex-row gap-4 mb-6 items-start">
    <div class="relative flex-1 max-w-sm">
      <input id="al-search" type="text" placeholder="Search action or admin..."
        class="w-full bg-surface border border-[#E5E7EB] rounded-xl px-4 py-2.5 pl-10 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors text-sm" />
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
    </div>
    <select id="al-action" class="bg-surface border border-[#E5E7EB] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral transition-colors text-sm">
      <option value="">All Actions</option>
      <option value="CREATE_SERVICE">Create Service</option>
      <option value="TERMINATE_SERVICE">Terminate Service</option>
      <option value="UPDATE_SERVICE_STATUS">Update Service Status</option>
      <option value="CREATE_INVOICE">Create Invoice</option>
      <option value="VOID_INVOICE">Void Invoice</option>
      <option value="MARK_INVOICE_PAID">Mark Invoice Paid</option>
      <option value="CREATE_USER">Create User</option>
      <option value="DELETE_USER">Delete User</option>
      <option value="RESET_PASSWORD">Reset Password</option>
      <option value="UPDATE_TICKET_STATUS">Update Ticket Status</option>
      <option value="TICKET_REPLY">Ticket Reply</option>
      <option value="BROADCAST">Broadcast</option>
      <option value="DELETE_PLAN">Delete Plan</option>
      <option value="DELETE_COUPON">Delete Coupon</option>
    </select>
    <p class="self-center text-text-muted text-sm" id="al-count"></p>
  </div>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-deep border-b border-[#E5E7EB]">
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">When</th>
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Admin</th>
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Action</th>
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Target</th>
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Details</th>
          </tr>
        </thead>
        <tbody id="al-table">
          <tr><td colspan="5" class="text-center py-10 text-text-muted">Loading...</td></tr>
        </tbody>
      </table>
    </div>
    <div class="flex items-center justify-between px-5 py-4 border-t border-[#E5E7EB]">
      <button id="al-prev" class="btn-ghost text-sm px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed">← Previous</button>
      <span id="al-page-info" class="text-text-muted text-sm">Page 1</span>
      <button id="al-next" class="btn-ghost text-sm px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed">Next →</button>
    </div>
  </div>

  <script>
    let allLogs: any[] = [];
    let page = 1;
    const PER_PAGE = 25;

    function actionColor(action: string) {
      if (action.includes('DELETE') || action.includes('TERMINATE') || action.includes('VOID')) return 'text-coral';
      if (action.includes('CREATE')) return 'text-green-400';
      return 'text-text-body';
    }

    function render() {
      const q = (document.getElementById('al-search') as HTMLInputElement).value.toLowerCase();
      const action = (document.getElementById('al-action') as HTMLSelectElement).value;
      const filtered = allLogs.filter(l =>
        (!q || l.action.toLowerCase().includes(q) || l.adminEmail.toLowerCase().includes(q) || (l.details || '').toLowerCase().includes(q)) &&
        (!action || l.action === action)
      );
      document.getElementById('al-count')!.textContent = `${filtered.length} entries`;
      const totalPages = Math.max(1, Math.ceil(filtered.length / PER_PAGE));
      if (page > totalPages) page = totalPages;
      const slice = filtered.slice((page - 1) * PER_PAGE, page * PER_PAGE);
      document.getElementById('al-page-info')!.textContent = `Page ${page} of ${totalPages}`;
      (document.getElementById('al-prev') as HTMLButtonElement).disabled = page <= 1;
      (document.getElementById('al-next') as HTMLButtonElement).disabled = page >= totalPages;

      const tbody = document.getElementById('al-table')!;
      if (!slice.length) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-10 text-text-muted text-sm">No entries found.</td></tr>';
        return;
      }
      tbody.innerHTML = slice.map((l: any) => `
        <tr class="border-b border-[#E5E7EB] hover:bg-surface transition-colors">
          <td class="px-5 py-3 text-text-muted text-xs whitespace-nowrap">${new Date(l.createdAt).toLocaleString()}</td>
          <td class="px-5 py-3 text-text-body text-xs">${l.adminEmail}</td>
          <td class="px-5 py-3 font-heading font-bold text-xs ${actionColor(l.action)}">${l.action.replace(/_/g, ' ')}</td>
          <td class="px-5 py-3 text-text-muted text-xs">${l.target || '—'}${l.targetId ? ` <span class="font-mono">${l.targetId.slice(0, 8)}…</span>` : ''}</td>
          <td class="px-5 py-3 text-text-muted text-xs max-w-xs truncate">${l.details || '—'}</td>
        </tr>
      `).join('');
    }

    document.getElementById('al-prev')!.addEventListener('click', () => { page--; render(); });
    document.getElementById('al-next')!.addEventListener('click', () => { page++; render(); });
    document.getElementById('al-search')!.addEventListener('input', () => { page = 1; render(); });
    document.getElementById('al-action')!.addEventListener('change', () => { page = 1; render(); });

    async function load() {
      try {
        const res = await fetch('/api/v1/admin/audit-log', { credentials: 'include' });
        const json = await res.json();
        allLogs = json.data?.logs || [];
        render();
      } catch {
        document.getElementById('al-table')!.innerHTML = '<tr><td colspan="5" class="text-center py-10 text-coral text-sm">Failed to load.</td></tr>';
      }
    }
    load();
  </script>
</AdminLayout>
