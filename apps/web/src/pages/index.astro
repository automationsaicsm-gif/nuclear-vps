---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingSection from '../components/sections/PricingSection';
import TestimonialsCarousel from '../components/sections/TestimonialsCarousel';
import FAQAccordion from '../components/sections/FAQAccordion';
---
<BaseLayout title="Nuclear VPS — High Performance Trading VPS" description="Powerful Forex VPS Optimized for Trading Robots and Expert Advisors. Low latency, 99.9% uptime, 24/7 support.">

  <!-- Hero -->
  <section class="bg-hero relative overflow-hidden py-20 lg:py-32">
    <div class="absolute top-0 left-0 w-96 h-96 rounded-full opacity-10" style="background:radial-gradient(circle,#60A5FA,transparent);transform:translate(-30%,-30%)"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 rounded-full opacity-10" style="background:radial-gradient(circle,#93C5FD,transparent);transform:translate(30%,30%)"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-12">
        <!-- Left -->
        <div class="lg:w-[55%]">
          <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-2 mb-6">
            <span class="text-white text-sm font-heading font-bold">⚡ Boost Your Trading!</span>
          </div>
          <h1 class="font-heading font-black text-4xl lg:text-5xl xl:text-6xl leading-tight mb-6">
            <span class="text-white">High Performance</span><br/>
            <span class="text-blue-200">Trading VPS</span>
          </h1>
          <p class="text-blue-100 text-lg mb-8 leading-relaxed">
            Powerful Forex VPS Optimized for Trading Robots and Expert Advisors.
          </p>

          <!-- Checkmarks -->
          <ul class="space-y-3 mb-10">
            {['Fully Managed & User-friendly', 'Supports All Trading Platforms', '24/7 Live Human Support', 'Ultra-Low Latency Network'].map((item) => (
              <li class="flex items-center gap-3">
                <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center shrink-0">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-blue-100">{item}</span>
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-4">
            <a href="#pricing" class="bg-white text-[#1A3A8F] font-heading font-black px-6 py-3 rounded-full hover:bg-blue-50 transition-all duration-200">Explore Our Services</a>
            <a href="#pricing" class="text-white font-heading font-bold underline underline-offset-4 hover:text-blue-200 transition-colors self-center">View Pricing</a>
          </div>
        </div>

        <!-- Right — Server Illustration -->
        <div class="lg:w-[45%] flex justify-center">
          <div class="animate-float">
            <div class="relative w-64 h-72">
              <!-- Server towers -->
              {[0, 1, 2].map((i) => (
                <div
                  class="absolute bg-[#0F172A] border border-[#1E3A8A] rounded-xl"
                  style={`width:70px;height:${140 + i*20}px;left:${i*80}px;bottom:0;box-shadow:0 0 20px rgba(45,85,200,0.2)`}
                >
                  <!-- Blue glow lines -->
                  {[0,1,2].map((j) => (
                    <div class="h-0.5 bg-blue-500/60 mx-3 rounded-full" style={`margin-top:${20+j*16}px`}></div>
                  ))}
                  <!-- Status dot -->
                  <div class="w-2.5 h-2.5 rounded-full bg-blue-400 absolute bottom-4 left-1/2 -translate-x-1/2" style="box-shadow:0 0 8px #60A5FA"></div>
                </div>
              ))}
              <!-- Glow base -->
              <div class="absolute bottom-0 left-0 right-0 h-4 rounded-full" style="background:radial-gradient(ellipse,rgba(45,85,200,0.4),transparent);filter:blur(8px)"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="bg-[#F3F4F6] border-y border-[#E5E7EB] py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap justify-around gap-6">
        {[
          { value: '1ms', label: 'Ultra-low Latency' },
          { value: '99.9%', label: 'Uptime Guarantee' },
          { value: '24/7', label: 'Live Support' },
          { value: '5★', label: 'Customer Rating' },
          { value: '2', label: 'Global Data Centers' },
        ].map(({ value, label }) => (
          <div class="text-center">
            <div class="font-heading font-black text-coral text-2xl lg:text-3xl count-stat">{value}</div>
            <div class="text-[#6B7280] text-xs mt-1">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="section-tag mb-3">Nuclear VPS FOR TRADING</p>
        <h2 class="font-heading font-black text-4xl lg:text-5xl text-[#111827] mb-4">Choose Your Perfect Plan</h2>
        <p class="text-[#6B7280] text-lg">High performance VPS optimized for Forex and algorithmic trading</p>
      </div>
      <PricingSection client:load />
    </div>
  </section>

  <!-- Guarantees -->
  <section class="bg-[#F9FAFB] py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="section-tag mb-3">WHY CHOOSE US?</p>
        <h2 class="font-heading font-black text-4xl text-[#111827] mb-4">Our Guarantees</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { icon: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z', title: '24/7 Expert Support', desc: 'Live human support whenever you need it.' },
          { icon: 'M13 10V3L4 14h7v7l9-11h-7z', title: 'High Server Performance', desc: 'Hyper-low latency. Run EAs 24/7 without interruption.' },
          { icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z', title: '99.9% Uptime Guarantee', desc: 'Constant uptime for the volatile Forex market.' },
          { icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z', title: 'New York Data Center', desc: 'New York — ultra-low latency to your broker.' },
          { icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z', title: 'Highest Server Security', desc: 'Redundant cloud monitoring, always protected.' },
          { icon: 'M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4', title: 'Daily Backups', desc: 'Restore any of the last 5 days of data anytime.' },
        ].map(({ icon, title, desc }) => (
          <div class="bg-white border border-[#E5E7EB] rounded-2xl p-6 hover:border-coral hover:shadow-[0_0_0_1px_#2D55C8] transition-all duration-200">
            <div class="w-10 h-10 bg-coral/10 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-coral" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icon}/>
              </svg>
            </div>
            <h3 class="font-heading font-black text-[#111827] text-lg mb-2">{title}</h3>
            <p class="text-[#6B7280] text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Support Stats -->
  <section class="bg-[#F3F4F6] border-y border-[#E5E7EB] py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-12 items-center">
        <div class="lg:w-3/5">
          <p class="section-tag mb-3">24/7 TECHNICAL SUPPORT</p>
          <h2 class="font-heading font-black text-3xl lg:text-4xl text-[#111827] mb-4">
            Our technical team is here to help you 24/7!
          </h2>
          <p class="text-[#374151] leading-relaxed">
            Whether you're having trouble connecting, need help setting up your trading platform, or have a billing question — our expert support team is always available via live chat and support tickets to get you back on track fast.
          </p>
        </div>
        <div class="lg:w-2/5 grid grid-cols-2 gap-6">
          {[
            { value: 99, unit: '%', label: 'Tickets Solved' },
            { value: 59, unit: ' sec', label: 'Live Chat Wait Time' },
            { value: 89, unit: '%', label: 'Satisfaction Rating' },
            { value: 76, unit: '%', label: 'First Time Resolution' },
          ].map(({ value, unit, label }) => (
            <div class="text-center">
              <div class="font-heading font-black text-coral text-4xl">{value}{unit}</div>
              <div class="font-heading font-black text-[#111827] text-sm mt-1">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="section-tag mb-3">CUSTOMER REVIEWS</p>
        <h2 class="font-heading font-black text-4xl text-[#111827] mb-4">Why Our Customers Love Our Services</h2>
      </div>
      <TestimonialsCarousel client:load />
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-[#F9FAFB] py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-heading font-black text-4xl text-[#111827]">Frequently Asked Questions</h2>
      </div>
      <FAQAccordion client:load />
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-hero py-20 text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading font-black text-4xl text-white mb-4">Let's Get Started</h2>
      <p class="text-blue-100 text-lg mb-8 leading-relaxed">
        Choose Nuclear VPS as your provider — fast setup for Algo Trading. Get started today and take your trading to the next level.
      </p>
      <a href="#pricing" class="bg-white text-[#1A3A8F] font-heading font-black text-lg px-10 py-4 rounded-full hover:bg-blue-50 transition-all duration-200">Get Started Now</a>
    </div>
  </section>

</BaseLayout>
