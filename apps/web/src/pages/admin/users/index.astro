---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Users — Nuclear VPS">

  <!-- Filters -->
  <div class="flex flex-col sm:flex-row gap-4 mb-6 items-start">
    <button id="create-user-btn" class="btn-primary text-sm px-5 py-2.5 shrink-0">+ Create User</button>
    <div class="relative flex-1 max-w-sm">
      <input id="user-search" type="text" placeholder="Search by name or email..."
        class="w-full bg-surface border border-[#E5E7EB] rounded-xl px-4 py-2.5 pl-10 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors text-sm" />
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
    </div>
    <select id="role-filter" class="bg-surface border border-[#E5E7EB] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral transition-colors text-sm">
      <option value="">All Roles</option>
      <option value="CLIENT">Client</option>
      <option value="ADMIN">Admin</option>
      <option value="SUPPORT">Support</option>
    </select>
    <p class="self-center text-text-muted text-sm" id="user-count"></p>
  </div>

  <!-- Table -->
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-deep border-b border-[#E5E7EB]">
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">User</th>
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Country</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Role</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Services</th>
            <th class="text-left px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Joined</th>
            <th class="text-center px-5 py-4 text-text-muted text-xs font-heading font-black uppercase tracking-wide">Actions</th>
          </tr>
        </thead>
        <tbody id="users-table">
          <tr><td colspan="6" class="text-center py-10 text-text-muted">Loading users...</td></tr>
        </tbody>
      </table>
    </div>
    <!-- Pagination -->
    <div class="flex items-center justify-between px-5 py-4 border-t border-[#E5E7EB]">
      <button id="prev-page" class="btn-ghost text-sm px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed">← Previous</button>
      <span id="page-info" class="text-text-muted text-sm">Page 1</span>
      <button id="next-page" class="btn-ghost text-sm px-4 py-2 disabled:opacity-40 disabled:cursor-not-allowed">Next →</button>
    </div>
  </div>

  <!-- Create User Modal -->
  <div id="create-user-modal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
    <div class="bg-surface border border-[#E5E7EB] rounded-2xl p-8 max-w-lg w-full">
      <h3 class="font-heading font-black text-text-h text-xl mb-6">Create User</h3>
      <div id="cu-error" class="hidden mb-4 bg-coral/10 border border-coral/30 rounded-xl p-3 text-coral text-sm"></div>
      <form id="create-user-form" class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">First Name</label>
            <input id="cu-first" type="text" required placeholder="John" class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm" />
          </div>
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Last Name</label>
            <input id="cu-last" type="text" required placeholder="Doe" class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm" />
          </div>
        </div>
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Email</label>
          <input id="cu-email" type="email" required placeholder="user@example.com" class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Password</label>
            <input id="cu-pw" type="text" required placeholder="Temporary password" class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm" />
          </div>
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Role</label>
            <select id="cu-role" class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral text-sm">
              <option value="CLIENT">Client</option>
              <option value="SUPPORT">Support</option>
              <option value="ADMIN">Admin</option>
            </select>
          </div>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" id="cu-cancel" class="btn-ghost flex-1 py-2.5">Cancel</button>
          <button type="submit" class="btn-primary flex-1 py-2.5">Create User</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Confirm modal -->
  <div id="confirm-modal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
    <div class="bg-surface border border-[#E5E7EB] rounded-2xl p-8 max-w-sm w-full">
      <h3 class="font-heading font-black text-text-h text-xl mb-3" id="modal-title">Confirm Action</h3>
      <p class="text-text-muted text-sm mb-6" id="modal-desc"></p>
      <div class="flex gap-3">
        <button id="modal-cancel" class="btn-ghost flex-1 py-2.5">Cancel</button>
        <button id="modal-confirm" class="btn-primary flex-1 py-2.5">Confirm</button>
      </div>
    </div>
  </div>

  <script>
    let allUsers: any[] = [];
    let page = 1;
    const PER_PAGE = 15;
    let pendingAction: (() => Promise<void>) | null = null;

    function badge(role: string) {
      const map: Record<string, string> = {
        ADMIN: 'bg-coral/10 text-coral border-coral/30',
        SUPPORT: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
        CLIENT: 'bg-indigo-mid/20 text-text-body border-[#E5E7EB]',
      };
      return `<span class="inline-block px-2 py-0.5 rounded-full text-xs font-heading font-black border ${map[role] || map.CLIENT}">${role}</span>`;
    }

    function renderPage() {
      const query = (document.getElementById('user-search') as HTMLInputElement).value.toLowerCase();
      const role = (document.getElementById('role-filter') as HTMLSelectElement).value;
      const filtered = allUsers.filter(u =>
        (!query || `${u.firstName} ${u.lastName} ${u.email}`.toLowerCase().includes(query)) &&
        (!role || u.role === role)
      );
      document.getElementById('user-count')!.textContent = `${filtered.length} users`;
      const totalPages = Math.max(1, Math.ceil(filtered.length / PER_PAGE));
      if (page > totalPages) page = totalPages;
      const slice = filtered.slice((page - 1) * PER_PAGE, page * PER_PAGE);
      document.getElementById('page-info')!.textContent = `Page ${page} of ${totalPages}`;
      (document.getElementById('prev-page') as HTMLButtonElement).disabled = page <= 1;
      (document.getElementById('next-page') as HTMLButtonElement).disabled = page >= totalPages;

      const tbody = document.getElementById('users-table')!;
      if (!slice.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center py-10 text-text-muted text-sm">No users found.</td></tr>';
        return;
      }
      tbody.innerHTML = slice.map((u: any) => `
        <tr class="border-b border-[#E5E7EB] hover:bg-surface transition-colors">
          <td class="px-5 py-4">
            <p class="font-heading font-bold text-text-h text-sm">${u.firstName} ${u.lastName}</p>
            <p class="text-text-muted text-xs">${u.email}</p>
          </td>
          <td class="px-5 py-4 text-text-body text-sm">${u.country}</td>
          <td class="px-5 py-4 text-center">${badge(u.role)}</td>
          <td class="px-5 py-4 text-center text-text-body text-sm">${u._count?.services ?? 0}</td>
          <td class="px-5 py-4 text-text-muted text-xs">${new Date(u.createdAt).toLocaleDateString()}</td>
          <td class="px-5 py-4 text-center">
            <div class="flex items-center justify-center gap-2">
              <a href="/admin/users/${u.id}" class="text-xs text-coral hover:underline font-heading font-bold">View</a>
              <button data-del-user="${u.id}" data-del-name="${u.firstName} ${u.lastName}" class="del-user-btn text-xs text-text-muted hover:text-coral font-heading font-bold">Delete</button>
            </div>
          </td>
        </tr>
      `).join('');
    }

    document.getElementById('users-table')!.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.del-user-btn') as HTMLElement | null;
      if (!btn) return;
      const id = btn.getAttribute('data-del-user')!;
      const name = btn.getAttribute('data-del-name')!;
      openModal(`Delete ${name}?`, `This will permanently delete the account and all associated data. This cannot be undone.`, async () => {
        await fetch(`/api/v1/admin/users/${id}`, { method: 'DELETE', credentials: 'include' });
        loadUsers();
      });
    });

    function openModal(title: string, desc: string, action: () => Promise<void>) {
      document.getElementById('modal-title')!.textContent = title;
      document.getElementById('modal-desc')!.textContent = desc;
      document.getElementById('confirm-modal')!.classList.remove('hidden');
      pendingAction = action;
    }

    document.getElementById('modal-cancel')!.addEventListener('click', () => {
      document.getElementById('confirm-modal')!.classList.add('hidden');
      pendingAction = null;
    });

    document.getElementById('modal-confirm')!.addEventListener('click', async () => {
      if (pendingAction) await pendingAction();
      document.getElementById('confirm-modal')!.classList.add('hidden');
      pendingAction = null;
    });

    document.getElementById('prev-page')!.addEventListener('click', () => { page--; renderPage(); });
    document.getElementById('next-page')!.addEventListener('click', () => { page++; renderPage(); });
    document.getElementById('user-search')!.addEventListener('input', () => { page = 1; renderPage(); });
    document.getElementById('role-filter')!.addEventListener('change', () => { page = 1; renderPage(); });

    async function loadUsers() {
      try {
        const res = await fetch('/api/v1/admin/users', { credentials: 'include' });
        const json = await res.json();
        allUsers = json.data?.users || [];
        renderPage();
      } catch {
        document.getElementById('users-table')!.innerHTML = '<tr><td colspan="6" class="text-center py-10 text-coral text-sm">Failed to load users.</td></tr>';
      }
    }
    loadUsers();

    // Create User modal
    const createModal = document.getElementById('create-user-modal')!;
    const cuError = document.getElementById('cu-error')!;

    document.getElementById('create-user-btn')!.addEventListener('click', () => {
      cuError.classList.add('hidden');
      createModal.classList.remove('hidden');
    });

    document.getElementById('cu-cancel')!.addEventListener('click', () => {
      createModal.classList.add('hidden');
      (document.getElementById('create-user-form') as HTMLFormElement).reset();
    });

    createModal.addEventListener('click', (e) => {
      if (e.target === createModal) {
        createModal.classList.add('hidden');
        (document.getElementById('create-user-form') as HTMLFormElement).reset();
      }
    });

    document.getElementById('create-user-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      cuError.classList.add('hidden');
      try {
        const res = await fetch('/api/v1/admin/users', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName: (document.getElementById('cu-first') as HTMLInputElement).value.trim(),
            lastName: (document.getElementById('cu-last') as HTMLInputElement).value.trim(),
            email: (document.getElementById('cu-email') as HTMLInputElement).value.trim(),
            password: (document.getElementById('cu-pw') as HTMLInputElement).value,
            role: (document.getElementById('cu-role') as HTMLSelectElement).value,
          }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Failed to create user.');
        createModal.classList.add('hidden');
        (document.getElementById('create-user-form') as HTMLFormElement).reset();
        loadUsers();
      } catch (err: any) {
        cuError.textContent = err.message;
        cuError.classList.remove('hidden');
      }
    });
  </script>
</AdminLayout>
