---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Forgot Password — Nuclear VPS" description="Reset your Nuclear VPS account password.">
  <section class="min-h-[80vh] flex items-center justify-center py-20 px-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-10">
        <a href="/" class="inline-block mb-8">
          <span class="font-heading font-black text-3xl text-text-h">NUCLEAR</span><span class="font-heading font-black text-3xl text-coral">VPS</span>
        </a>
        <h1 class="font-heading font-black text-3xl text-text-h mb-2">Reset Your Password</h1>
        <p class="text-text-muted">Enter your email and we'll send you a reset link</p>
      </div>

      <div class="bg-surface border border-[#312E81] rounded-2xl p-8">
        <div id="fp-error" class="hidden mb-6 bg-coral/10 border border-coral/30 rounded-xl p-4 text-coral text-sm"></div>
        <div id="fp-success" class="hidden mb-6 bg-green-500/10 border border-green-500/30 rounded-xl p-4 text-green-400 text-sm"></div>

        <form id="fp-form" class="space-y-5">
          <div>
            <label class="block text-text-body text-sm font-heading font-bold mb-2" for="email">Email Address</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors"
              placeholder="you@example.com"
            />
          </div>

          <button type="submit" id="fp-btn"
            class="w-full btn-primary py-3 text-base flex items-center justify-center gap-2">
            <span id="fp-btn-text">Send Reset Link</span>
            <svg id="fp-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
            </svg>
          </button>
        </form>

        <p class="text-center text-text-muted text-sm mt-6">
          Remember your password?
          <a href="/login" class="text-coral font-heading font-bold hover:underline ml-1">Sign in</a>
        </p>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('fp-form') as HTMLFormElement;
    const errorBox = document.getElementById('fp-error')!;
    const successBox = document.getElementById('fp-success')!;
    const btn = document.getElementById('fp-btn') as HTMLButtonElement;
    const btnText = document.getElementById('fp-btn-text')!;
    const spinner = document.getElementById('fp-spinner')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      successBox.classList.add('hidden');
      btn.disabled = true;
      btnText.textContent = 'Sending...';
      spinner.classList.remove('hidden');

      const data = Object.fromEntries(new FormData(form));

      try {
        const res = await fetch('/api/v1/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: data.email }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Request failed');

        successBox.textContent = 'Reset link sent! Check your email (including spam folder).';
        successBox.classList.remove('hidden');
        form.reset();
      } catch (err: any) {
        errorBox.textContent = err.message;
        errorBox.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btnText.textContent = 'Send Reset Link';
        spinner.classList.add('hidden');
      }
    });
  </script>
</BaseLayout>
