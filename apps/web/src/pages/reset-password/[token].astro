---
import BaseLayout from '../../layouts/BaseLayout.astro';
const { token } = Astro.params;
---
<BaseLayout title="Reset Password — Nuclear VPS" description="Set your new Nuclear VPS account password.">
  <section class="min-h-[80vh] flex items-center justify-center py-20 px-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-10">
        <a href="/" class="inline-block mb-8">
          <span class="font-heading font-black text-3xl text-text-h">NUCLEAR</span><span class="font-heading font-black text-3xl text-coral">VPS</span>
        </a>
        <h1 class="font-heading font-black text-3xl text-text-h mb-2">Set New Password</h1>
        <p class="text-text-muted">Choose a strong password for your account</p>
      </div>

      <div class="bg-surface border border-[#312E81] rounded-2xl p-8">
        <div id="rp-error" class="hidden mb-6 bg-coral/10 border border-coral/30 rounded-xl p-4 text-coral text-sm"></div>
        <div id="rp-success" class="hidden mb-6 bg-green-500/10 border border-green-500/30 rounded-xl p-4 text-green-400 text-sm"></div>

        <form id="rp-form" class="space-y-5">
          <input type="hidden" id="reset-token" value={token} />

          <div>
            <label class="block text-text-body text-sm font-heading font-bold mb-2" for="password">New Password</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              minlength="8"
              class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors"
              placeholder="Min 8 characters"
            />
          </div>

          <div>
            <label class="block text-text-body text-sm font-heading font-bold mb-2" for="confirmPassword">Confirm New Password</label>
            <input
              id="confirmPassword"
              name="confirmPassword"
              type="password"
              required
              class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors"
              placeholder="Repeat new password"
            />
          </div>

          <button type="submit" id="rp-btn"
            class="w-full btn-primary py-3 text-base flex items-center justify-center gap-2">
            <span id="rp-btn-text">Update Password</span>
            <svg id="rp-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('rp-form') as HTMLFormElement;
    const errorBox = document.getElementById('rp-error')!;
    const successBox = document.getElementById('rp-success')!;
    const btn = document.getElementById('rp-btn') as HTMLButtonElement;
    const btnText = document.getElementById('rp-btn-text')!;
    const spinner = document.getElementById('rp-spinner')!;
    const tokenInput = document.getElementById('reset-token') as HTMLInputElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      successBox.classList.add('hidden');

      const data = Object.fromEntries(new FormData(form));
      if (data.password !== data.confirmPassword) {
        errorBox.textContent = 'Passwords do not match.';
        errorBox.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      btnText.textContent = 'Updating...';
      spinner.classList.remove('hidden');

      try {
        const res = await fetch('/api/v1/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: tokenInput.value, password: data.password }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Reset failed');

        successBox.textContent = 'Password updated! Redirecting to login...';
        successBox.classList.remove('hidden');
        setTimeout(() => { window.location.href = '/login'; }, 2000);
      } catch (err: any) {
        errorBox.textContent = err.message;
        errorBox.classList.remove('hidden');
        btn.disabled = false;
        btnText.textContent = 'Update Password';
        spinner.classList.add('hidden');
      }
    });
  </script>
</BaseLayout>
