---
import AdminLayout from '../../../layouts/AdminLayout.astro';
const { id } = Astro.params;
---
<AdminLayout title="User Detail — Nuclear VPS">

  <div class="mb-6">
    <a href="/admin/users" class="text-coral text-sm font-heading font-bold hover:underline">← Back to Users</a>
  </div>

  <div id="user-loading" class="text-center py-20 text-text-muted">Loading user...</div>
  <div id="user-content" class="hidden space-y-8">

    <!-- Profile header -->
    <div class="card p-6 flex items-center gap-6">
      <div class="w-20 h-20 rounded-2xl bg-indigo-mid flex items-center justify-center shrink-0">
        <span class="font-heading font-black text-coral text-2xl" id="user-initials">?</span>
      </div>
      <div class="flex-1 min-w-0">
        <h2 class="font-heading font-black text-text-h text-2xl" id="user-fullname"></h2>
        <p class="text-text-muted" id="user-email"></p>
        <div class="flex items-center gap-3 mt-2">
          <span id="user-role-badge"></span>
          <span class="text-text-muted text-xs" id="user-joined"></span>
        </div>
      </div>
      <div class="flex gap-3 shrink-0 flex-wrap">
        <button id="reset-pw-btn" class="btn-ghost text-sm px-4 py-2">Reset Password</button>
        <button id="impersonate-btn" class="btn-ghost text-sm px-4 py-2">Impersonate</button>
        <button id="delete-user-btn" class="border border-coral text-coral hover:bg-coral hover:text-white rounded-xl px-4 py-2 text-sm font-heading font-bold transition-all">Delete User</button>
      </div>
    </div>

    <!-- Edit form -->
    <div class="card p-6">
      <h3 class="font-heading font-black text-text-h text-lg mb-6">Edit Profile</h3>
      <div id="edit-error" class="hidden mb-4 bg-coral/10 border border-coral/30 rounded-xl p-4 text-coral text-sm"></div>
      <div id="edit-success" class="hidden mb-4 bg-green-500/10 border border-green-500/30 rounded-xl p-4 text-green-400 text-sm"></div>
      <form id="edit-form" class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">First Name</label>
          <input id="ef-firstName" name="firstName" type="text" class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors text-sm" />
        </div>
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Last Name</label>
          <input id="ef-lastName" name="lastName" type="text" class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors text-sm" />
        </div>
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Email</label>
          <input id="ef-email" name="email" type="email" class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors text-sm" />
        </div>
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Role</label>
          <select id="ef-role" name="role" class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors text-sm">
            <option value="CLIENT">Client</option>
            <option value="SUPPORT">Support</option>
            <option value="ADMIN">Admin</option>
          </select>
        </div>
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Phone</label>
          <input id="ef-phone" name="phone" type="tel" class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors text-sm" />
        </div>
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Country</label>
          <input id="ef-country" name="country" type="text" class="w-full bg-base border border-[#E5E7EB] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors text-sm" />
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="btn-primary px-8 py-2.5 text-sm">Save Changes</button>
        </div>
      </form>
    </div>

    <!-- Services -->
    <div class="card p-6">
      <h3 class="font-heading font-black text-text-h text-lg mb-4">Services</h3>
      <div id="user-services" class="text-text-muted text-sm">Loading...</div>
    </div>

    <!-- Invoices -->
    <div class="card p-6">
      <h3 class="font-heading font-black text-text-h text-lg mb-4">Invoices</h3>
      <div id="user-invoices" class="text-text-muted text-sm">Loading...</div>
    </div>

    <!-- Tickets -->
    <div class="card p-6">
      <h3 class="font-heading font-black text-text-h text-lg mb-4">Support Tickets</h3>
      <div id="user-tickets" class="text-text-muted text-sm">Loading...</div>
    </div>
  </div>

  <script define:vars={{ id }}>
    async function load() {
      try {
        const res = await fetch(`/api/v1/admin/users/${id}`, { credentials: 'include' });
        if (!res.ok) throw new Error('Not found');
        const json = await res.json();
        const u = json.data?.user;

        document.getElementById('user-initials')!.textContent = (u.firstName?.[0] || '') + (u.lastName?.[0] || '');
        document.getElementById('user-fullname')!.textContent = `${u.firstName} ${u.lastName}`;
        document.getElementById('user-email')!.textContent = u.email;
        document.getElementById('user-joined')!.textContent = `Joined ${new Date(u.createdAt).toLocaleDateString()}`;

        const roleColors: Record<string, string> = {
          ADMIN: 'bg-coral/10 text-coral border-coral/30',
          SUPPORT: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
          CLIENT: 'bg-indigo-mid/20 text-text-body border-[#E5E7EB]',
        };
        document.getElementById('user-role-badge')!.innerHTML = `<span class="inline-block px-2 py-0.5 rounded-full text-xs font-heading font-black border ${roleColors[u.role] || roleColors.CLIENT}">${u.role}</span>`;

        // Prefill form
        (document.getElementById('ef-firstName') as HTMLInputElement).value = u.firstName || '';
        (document.getElementById('ef-lastName') as HTMLInputElement).value = u.lastName || '';
        (document.getElementById('ef-email') as HTMLInputElement).value = u.email || '';
        (document.getElementById('ef-role') as HTMLSelectElement).value = u.role || 'CLIENT';
        (document.getElementById('ef-phone') as HTMLInputElement).value = u.phone || '';
        (document.getElementById('ef-country') as HTMLInputElement).value = u.country || '';

        // Services
        const services: any[] = u.services || [];
        document.getElementById('user-services')!.innerHTML = services.length
          ? services.map((s: any) => `<div class="flex items-center justify-between py-2 border-b border-[#E5E7EB] last:border-0"><span class="text-text-body text-sm">${s.plan?.name || s.planId}</span><span class="text-xs px-2 py-0.5 rounded-full font-heading font-black ${s.status === 'ACTIVE' ? 'bg-green-500/10 text-green-400' : 'bg-surface text-text-muted'}">${s.status}</span></div>`).join('')
          : 'No services.';

        // Invoices
        const invoices: any[] = u.invoices || [];
        document.getElementById('user-invoices')!.innerHTML = invoices.length
          ? invoices.map((inv: any) => `<div class="flex items-center justify-between py-2 border-b border-[#E5E7EB] last:border-0"><span class="font-mono text-xs text-text-body">${inv.invoiceNumber}</span><span class="text-coral font-heading font-black">$${inv.amount.toFixed(2)}</span><span class="text-xs text-text-muted">${inv.status}</span></div>`).join('')
          : 'No invoices.';

        // Tickets
        const tickets: any[] = u.tickets || [];
        document.getElementById('user-tickets')!.innerHTML = tickets.length
          ? tickets.map((t: any) => `<div class="flex items-center justify-between py-2 border-b border-[#E5E7EB] last:border-0"><span class="text-text-body text-sm">${t.subject}</span><span class="text-xs text-text-muted">${t.status}</span></div>`).join('')
          : 'No tickets.';

        document.getElementById('user-loading')!.classList.add('hidden');
        document.getElementById('user-content')!.classList.remove('hidden');
      } catch {
        document.getElementById('user-loading')!.innerHTML = '<p class="text-coral">User not found.</p>';
      }
    }

    document.getElementById('edit-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(e.target as HTMLFormElement));
      const errEl = document.getElementById('edit-error')!;
      const sucEl = document.getElementById('edit-success')!;
      errEl.classList.add('hidden');
      sucEl.classList.add('hidden');
      try {
        const res = await fetch(`/api/v1/admin/users/${id}`, {
          method: 'PUT', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error);
        sucEl.textContent = 'User updated successfully.';
        sucEl.classList.remove('hidden');
      } catch (err: any) {
        errEl.textContent = err.message;
        errEl.classList.remove('hidden');
      }
    });

    document.getElementById('delete-user-btn')!.addEventListener('click', async () => {
      if (!confirm('Permanently delete this user and all their data? This cannot be undone.')) return;
      const res = await fetch(`/api/v1/admin/users/${id}`, { method: 'DELETE', credentials: 'include' });
      if (res.ok) {
        window.location.href = '/admin/users';
      } else {
        alert('Failed to delete user.');
      }
    });

    document.getElementById('reset-pw-btn')!.addEventListener('click', async () => {
      const newPw = prompt('Enter new password for this user (min 8 chars):');
      if (!newPw || newPw.length < 8) { alert('Password must be at least 8 characters.'); return; }
      const res = await fetch(`/api/v1/admin/users/${id}/reset-password`, {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: newPw }),
      });
      if (res.ok) {
        alert('Password updated successfully.');
      } else {
        alert('Failed to reset password.');
      }
    });

    document.getElementById('impersonate-btn')!.addEventListener('click', async () => {
      const res = await fetch(`/api/v1/admin/users/${id}/impersonate`, { method: 'POST', credentials: 'include' });
      const json = await res.json();
      if (json.data?.user) {
        localStorage.setItem('nuclear-vps-auth', JSON.stringify({ state: { user: json.data.user } }));
        window.location.href = '/dashboard';
      }
    });

    load();
  </script>
</AdminLayout>
