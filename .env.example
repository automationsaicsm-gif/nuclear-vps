# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/dipgate"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-here"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="your-cookie-secret-min-32-chars-here"

# App
NODE_ENV="development"
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
PORT=4000

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Dipgate <noreply@dipgate.com>"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# PayPal
PAYPAL_CLIENT_ID="..."
PAYPAL_CLIENT_SECRET="..."
PAYPAL_MODE="sandbox"

# Coinbase Commerce
COINBASE_API_KEY="..."
COINBASE_WEBHOOK_SECRET="..."

# Admin
ADMIN_EMAIL="admin@dipgate.com"
ADMIN_PASSWORD="Admin@123456"
