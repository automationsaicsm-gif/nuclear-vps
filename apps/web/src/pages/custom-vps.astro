---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/sections/ContactForm';
---
<BaseLayout title="Brokers & Custom VPS — Nuclear VPS" description="Custom Forex VPS solutions for brokers and institutional clients. White-label, bulk pricing, and dedicated infrastructure tailored to your needs.">

  <!-- Hero -->
  <section class="bg-hero relative overflow-hidden py-20 lg:py-32">
    <div class="absolute top-0 left-0 w-96 h-96 rounded-full opacity-10" style="background:radial-gradient(circle,#4F46E5,transparent);transform:translate(-30%,-30%)"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 rounded-full opacity-10" style="background:radial-gradient(circle,#F87171,transparent);transform:translate(30%,30%)"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-12">
        <div class="lg:w-3/5">
          <div class="inline-flex items-center gap-2 bg-coral/10 border border-coral/30 rounded-full px-4 py-2 mb-6">
            <span class="text-coral text-sm font-heading font-bold">🏢 Institutional Solutions</span>
          </div>
          <h1 class="font-heading font-black text-4xl lg:text-6xl text-text-h mb-6">
            Brokers &amp; Custom<br/><span class="text-coral">VPS Solutions</span>
          </h1>
          <p class="text-text-body text-xl mb-8 leading-relaxed">
            Offer your traders a premium VPS experience without building the infrastructure yourself. Nuclear VPS provides white-label and bulk VPS solutions tailored for Forex brokers and institutional clients.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="#contact-form" class="btn-primary text-lg px-8 py-4">Get a Custom Quote</a>
            <a href="/contact-us" class="btn-ghost text-lg px-8 py-4">Speak to Sales</a>
          </div>
        </div>
        <div class="lg:w-2/5">
          <div class="bg-deep border border-[#312E81] rounded-2xl p-8" style="box-shadow:0 0 40px rgba(248,113,113,0.08)">
            <h3 class="font-heading font-black text-text-h text-lg mb-6">Custom solutions include:</h3>
            <ul class="space-y-3">
              {[
                'White-label VPS portal with your branding',
                'Bulk pricing for 10+ VPS orders',
                'Dedicated account manager',
                'Custom server locations on request',
                'API integration with your broker platform',
                'Priority SLA and uptime guarantees',
                'Custom billing cycles and invoicing',
              ].map((item) => (
                <li class="flex items-center gap-3">
                  <div class="w-5 h-5 rounded-full bg-coral flex items-center justify-center shrink-0">
                    <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-text-body text-sm">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="bg-base py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="section-tag mb-3">WHY Nuclear VPS FOR BROKERS</p>
        <h2 class="font-heading font-black text-4xl text-text-h mb-4">Benefits for Your Business</h2>
        <p class="text-text-muted text-lg">Built for businesses that need reliability, scale, and control</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
            title: 'White-Label Portal',
            desc: 'Offer VPS services under your own brand. Fully customizable portal with your logo, colors, and domain.',
          },
          {
            icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
            title: 'Bulk Provisioning',
            desc: 'Provision hundreds of VPS instances at once via API. Perfect for brokers onboarding large numbers of traders.',
          },
          {
            icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
            title: 'Enterprise SLA',
            desc: '99.99% uptime SLA with financial penalties. Dedicated hardware and network resources for your clients.',
          },
          {
            icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01',
            title: 'Consolidated Billing',
            desc: 'Single monthly invoice for all your clients. Custom pricing tiers and volume discounts negotiated directly.',
          },
          {
            icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
            title: 'API Integration',
            desc: 'Full REST API for automated VPS provisioning, suspension, and management integrated with your broker backend.',
          },
          {
            icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
            title: 'Dedicated Account Manager',
            desc: 'A named technical account manager available to your team directly, not a ticket queue.',
          },
        ].map(({ icon, title, desc }) => (
          <div class="bg-surface border border-[#312E81] rounded-2xl p-6 hover:border-coral hover:shadow-[0_0_0_1px_#F87171] transition-all duration-200">
            <div class="w-10 h-10 bg-deep rounded-xl flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-coral" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icon}/>
              </svg>
            </div>
            <h3 class="font-heading font-black text-text-h text-lg mb-2">{title}</h3>
            <p class="text-text-muted text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing tiers hint -->
  <section class="bg-surface py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-tag mb-3">VOLUME PRICING</p>
        <h2 class="font-heading font-black text-4xl text-text-h mb-4">Volume Discounts</h2>
        <p class="text-text-muted text-lg">The more VPS instances you need, the better the price</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {[
          { range: '10–49 VPS', discount: '10%', desc: 'Perfect for small brokerages with an active retail client base.' },
          { range: '50–199 VPS', discount: '20%', desc: 'Mid-size brokers with a growing algorithmic trading clientele.' },
          { range: '200+ VPS', discount: 'Custom', desc: 'Enterprise pricing, dedicated infrastructure, and white-label options.' },
        ].map(({ range, discount, desc }) => (
          <div class="bg-base border border-[#312E81] rounded-2xl p-6 text-center hover:border-coral hover:shadow-[0_0_0_1px_#F87171] transition-all duration-200">
            <div class="font-heading font-black text-text-muted text-sm mb-2">{range}</div>
            <div class="font-heading font-black text-coral text-4xl mb-3">{discount}</div>
            <div class="text-text-muted text-xs mb-1">off standard pricing</div>
            <div class="border-t border-[#312E81] my-4"></div>
            <p class="text-text-body text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section id="contact-form" class="bg-base py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-tag mb-3">GET IN TOUCH</p>
        <h2 class="font-heading font-black text-4xl text-text-h mb-4">Request a Custom Quote</h2>
        <p class="text-text-muted text-lg">Tell us about your business and requirements. We will prepare a custom proposal within 24 hours.</p>
      </div>
      <ContactForm
        client:load
        formTitle="Custom VPS Inquiry"
        subjectOptions={[
          'White-Label VPS Portal',
          'Bulk VPS Pricing (10+ VPS)',
          'API Integration Inquiry',
          'Enterprise SLA Discussion',
          'General Custom VPS Inquiry',
        ]}
        successMessage="Thanks for your inquiry! Our enterprise team will contact you within 24 hours with a custom proposal."
      />
    </div>
  </section>

</BaseLayout>
