---
---
<nav id="navbar" class="bg-surface/95 backdrop-blur-md border-b border-[#312E81] sticky top-0 z-40 transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <span class="font-heading font-black text-2xl text-text-h">NUCLEAR</span><span class="font-heading font-black text-2xl text-coral">VPS</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-6">
        <div class="relative group">
          <button class="font-heading font-bold text-text-body hover:text-coral transition-colors flex items-center gap-1">
            Services
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="absolute top-full left-0 w-48 hidden group-hover:block pt-2">
            <div class="bg-surface border border-[#312E81] rounded-xl shadow-xl">
              <a href="/trading-vps" class="block px-4 py-3 text-text-body hover:text-coral hover:bg-deep transition-colors rounded-t-xl">Trading VPS</a>
              <a href="/trading-servers" class="block px-4 py-3 text-text-body hover:text-coral hover:bg-deep transition-colors rounded-b-xl">Trading Servers</a>
            </div>
          </div>
        </div>

        <div class="relative group">
          <button class="font-heading font-bold text-text-body hover:text-coral transition-colors flex items-center gap-1">
            Partnership
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="absolute top-full left-0 w-56 hidden group-hover:block pt-2">
            <div class="bg-surface border border-[#312E81] rounded-xl shadow-xl">
              <a href="/affiliates" class="block px-4 py-3 text-text-body hover:text-coral hover:bg-deep transition-colors rounded-t-xl">Affiliates</a>
              <a href="/expert-advisor-partnership" class="block px-4 py-3 text-text-body hover:text-coral hover:bg-deep transition-colors">EA Business</a>
              <a href="/custom-vps" class="block px-4 py-3 text-text-body hover:text-coral hover:bg-deep transition-colors rounded-b-xl">Brokers &amp; Custom</a>
            </div>
          </div>
        </div>

        <a href="/forex-broker-latency" class="font-heading font-bold text-text-body hover:text-coral transition-colors">Broker Latency</a>
        <a href="/contact-us" class="font-heading font-bold text-text-body hover:text-coral transition-colors">Contact</a>
        <a href="/knowledgebase" class="font-heading font-bold text-text-body hover:text-coral transition-colors">Knowledgebase</a>
      </div>

      <!-- Auth buttons / User menu -->
      <div class="hidden md:flex items-center gap-3" id="nav-auth">
        <a href="/register" class="btn-ghost text-sm px-4 py-2">Register</a>
        <a href="/login" class="border-2 border-coral text-coral hover:bg-coral hover:text-white font-heading font-bold px-5 py-2 rounded-full transition-all duration-200 text-sm">Login</a>
      </div>

      <!-- Mobile hamburger -->
      <button id="mobile-menu-btn" class="md:hidden text-text-body hover:text-coral transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden hidden pb-4">
      <div class="flex flex-col gap-2 pt-2 border-t border-[#312E81]">
        <a href="/trading-vps" class="font-heading font-bold text-text-body hover:text-coral py-2 transition-colors">Trading VPS</a>
        <a href="/trading-servers" class="font-heading font-bold text-text-body hover:text-coral py-2 transition-colors">Trading Servers</a>
        <a href="/affiliates" class="font-heading font-bold text-text-body hover:text-coral py-2 transition-colors">Affiliates</a>
        <a href="/expert-advisor-partnership" class="font-heading font-bold text-text-body hover:text-coral py-2 transition-colors">EA Business</a>
        <a href="/custom-vps" class="font-heading font-bold text-text-body hover:text-coral py-2 transition-colors">Brokers &amp; Custom</a>
        <a href="/forex-broker-latency" class="font-heading font-bold text-text-body hover:text-coral py-2 transition-colors">Broker Latency</a>
        <a href="/contact-us" class="font-heading font-bold text-text-body hover:text-coral py-2 transition-colors">Contact</a>
        <a href="/knowledgebase" class="font-heading font-bold text-text-body hover:text-coral py-2 transition-colors">Knowledgebase</a>
        <div class="flex gap-3 pt-2">
          <a href="/register" class="btn-ghost text-sm flex-1 text-center">Register</a>
          <a href="/login" class="btn-primary text-sm flex-1 text-center">Login</a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

  // Update auth section if user is logged in
  const stored = localStorage.getItem('nuclear-vps-auth');
  if (stored) {
    try {
      const state = JSON.parse(stored);
      const user = state?.state?.user;
      if (user) {
        const authDiv = document.getElementById('nav-auth');
        if (authDiv) {
          authDiv.innerHTML = `
            <div class="relative group">
              <button class="flex items-center gap-2 font-heading font-bold text-text-body hover:text-coral transition-colors">
                <div class="w-8 h-8 rounded-full bg-indigo-mid flex items-center justify-center text-coral font-black text-sm">
                  ${user.firstName[0]}${user.lastName[0]}
                </div>
                <span>${user.firstName}</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div class="absolute right-0 top-full w-48 hidden group-hover:block pt-2">
                <div class="bg-surface border border-[#312E81] rounded-xl shadow-xl">
                  <a href="/dashboard" class="block px-4 py-3 text-text-body hover:text-coral hover:bg-deep transition-colors rounded-t-xl">Dashboard</a>
                  <a href="/dashboard/account" class="block px-4 py-3 text-text-body hover:text-coral hover:bg-deep transition-colors">Account</a>
                  ${user.role === 'ADMIN' ? '<a href="/admin" class="block px-4 py-3 text-text-body hover:text-coral hover:bg-deep transition-colors">Admin Panel</a>' : ''}
                  <button id="nav-logout" class="w-full text-left block px-4 py-3 text-coral hover:bg-deep transition-colors rounded-b-xl">Logout</button>
                </div>
              </div>
            </div>
          `;
          document.getElementById('nav-logout')?.addEventListener('click', async () => {
            await fetch('/api/v1/auth/logout', { method: 'POST', credentials: 'include' });
            localStorage.removeItem('nuclear-vps-auth');
            window.location.href = '/';
          });
        }
      }
    } catch {}
  }
</script>
