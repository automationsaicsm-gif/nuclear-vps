---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Tickets — Nuclear VPS">

  <div class="flex flex-col sm:flex-row gap-4 mb-6">
    <div class="relative flex-1 max-w-sm">
      <input id="tkt-search" type="text" placeholder="Search subject or client..."
        class="w-full bg-surface border border-[#312E81] rounded-xl px-4 py-2.5 pl-10 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors text-sm" />
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
    </div>
    <select id="tkt-dept" class="bg-surface border border-[#312E81] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral transition-colors text-sm">
      <option value="">All Departments</option>
      <option value="GENERAL">General</option>
      <option value="BILLING">Billing</option>
      <option value="TECHNICAL">Technical</option>
      <option value="SALES">Sales</option>
    </select>
    <select id="tkt-status" class="bg-surface border border-[#312E81] rounded-xl px-4 py-2.5 text-text-h focus:outline-none focus:border-coral transition-colors text-sm">
      <option value="">All Statuses</option>
      <option value="OPEN">Open</option>
      <option value="IN_PROGRESS">In Progress</option>
      <option value="WAITING_CLIENT">Waiting Client</option>
      <option value="RESOLVED">Resolved</option>
      <option value="CLOSED">Closed</option>
    </select>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Ticket list -->
    <div class="lg:col-span-1 card overflow-hidden">
      <div class="p-4 border-b border-[#312E81]">
        <p class="font-heading font-black text-text-h text-sm" id="ticket-count">All Tickets</p>
      </div>
      <div id="ticket-list" class="overflow-y-auto max-h-[600px] divide-y divide-[#312E81]">
        <p class="text-text-muted text-sm p-4">Loading...</p>
      </div>
    </div>

    <!-- Ticket detail -->
    <div class="lg:col-span-2 card p-6">
      <div id="ticket-empty" class="flex items-center justify-center h-full min-h-[300px] text-text-muted text-sm">
        Select a ticket to view and reply
      </div>
      <div id="ticket-detail" class="hidden">
        <div class="flex items-start justify-between mb-6">
          <div>
            <h2 class="font-heading font-black text-text-h text-xl" id="td-subject"></h2>
            <p class="text-text-muted text-sm mt-1" id="td-meta"></p>
          </div>
          <div id="td-priority-badge"></div>
        </div>
        <div id="td-messages" class="space-y-4 mb-6 max-h-96 overflow-y-auto pr-2"></div>
        <div class="border-t border-[#312E81] pt-4">
          <textarea id="reply-text" rows="3" placeholder="Type your reply..."
            class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h placeholder-text-muted focus:outline-none focus:border-coral transition-colors text-sm resize-none mb-3"></textarea>
          <div class="flex gap-3">
            <button id="reply-btn" class="btn-primary text-sm px-6 py-2.5">Send Reply</button>
            <button id="close-ticket-btn" class="btn-ghost text-sm px-6 py-2.5">Close Ticket</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let allTickets: any[] = [];
    let activeTicketId: string | null = null;

    function priorityColor(p: string) {
      const map: Record<string, string> = {
        URGENT: 'bg-coral/10 text-coral border-coral/30',
        HIGH: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
        MEDIUM: 'bg-indigo-mid/20 text-text-body border-[#312E81]',
        LOW: 'bg-surface text-text-muted border-[#312E81]',
      };
      return map[p] || map.LOW;
    }

    function renderList() {
      const q = (document.getElementById('tkt-search') as HTMLInputElement).value.toLowerCase();
      const dept = (document.getElementById('tkt-dept') as HTMLSelectElement).value;
      const status = (document.getElementById('tkt-status') as HTMLSelectElement).value;
      const filtered = allTickets.filter(t =>
        (!q || t.subject.toLowerCase().includes(q) || `${t.user?.firstName} ${t.user?.lastName}`.toLowerCase().includes(q)) &&
        (!dept || t.department === dept) &&
        (!status || t.status === status)
      );
      document.getElementById('ticket-count')!.textContent = `${filtered.length} ticket${filtered.length !== 1 ? 's' : ''}`;
      const list = document.getElementById('ticket-list')!;
      if (!filtered.length) {
        list.innerHTML = '<p class="text-text-muted text-sm p-4">No tickets found.</p>';
        return;
      }
      list.innerHTML = filtered.map((t: any) => `
        <button data-tid="${t.id}" class="ticket-item w-full text-left px-4 py-3 hover:bg-surface transition-colors ${t.id === activeTicketId ? 'bg-surface border-l-4 border-coral' : ''}">
          <div class="flex items-start justify-between gap-2">
            <p class="font-heading font-bold text-text-h text-sm truncate">${t.subject}</p>
            <span class="inline-block px-2 py-0.5 rounded-full text-xs font-heading font-black border shrink-0 ${priorityColor(t.priority)}">${t.priority}</span>
          </div>
          <p class="text-text-muted text-xs mt-1">${t.user?.firstName || ''} ${t.user?.lastName || ''} · ${t.department}</p>
          <p class="text-text-muted text-xs">${t.status}</p>
        </button>
      `).join('');

      document.querySelectorAll('.ticket-item').forEach(btn => {
        btn.addEventListener('click', () => {
          activeTicketId = btn.getAttribute('data-tid')!;
          loadTicketDetail(activeTicketId);
          renderList();
        });
      });
    }

    async function loadTicketDetail(id: string) {
      const res = await fetch(`/api/v1/tickets/${id}`, { credentials: 'include' });
      const json = await res.json();
      const t = json.data?.ticket;
      if (!t) return;

      document.getElementById('ticket-empty')!.classList.add('hidden');
      document.getElementById('ticket-detail')!.classList.remove('hidden');
      document.getElementById('td-subject')!.textContent = t.subject;
      document.getElementById('td-meta')!.textContent = `${t.department} · ${t.user?.email || ''} · #${t.ticketNumber}`;
      document.getElementById('td-priority-badge')!.innerHTML = `<span class="inline-block px-2 py-0.5 rounded-full text-xs font-heading font-black border ${priorityColor(t.priority)}">${t.priority}</span>`;

      const msgs = t.messages || [];
      document.getElementById('td-messages')!.innerHTML = msgs.map((m: any) => `
        <div class="${m.authorRole === 'CLIENT' ? 'ml-6' : 'mr-6'}">
          <div class="${m.authorRole === 'CLIENT' ? 'bg-indigo-mid/20' : 'bg-surface'} rounded-xl p-4 border border-[#312E81]">
            <div class="flex items-center justify-between mb-2">
              <p class="font-heading font-bold text-text-h text-xs">${m.authorRole === 'CLIENT' ? 'Client' : 'Support'}</p>
              <p class="text-text-muted text-xs">${new Date(m.createdAt).toLocaleString()}</p>
            </div>
            <p class="text-text-body text-sm leading-relaxed">${m.message}</p>
          </div>
        </div>
      `).join('');

      document.getElementById('reply-btn')!.onclick = async () => {
        const msg = (document.getElementById('reply-text') as HTMLTextAreaElement).value.trim();
        if (!msg) return;
        await fetch(`/api/v1/admin/tickets/${id}/reply`, {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: msg }),
        });
        (document.getElementById('reply-text') as HTMLTextAreaElement).value = '';
        loadTicketDetail(id);
      };

      document.getElementById('close-ticket-btn')!.onclick = async () => {
        await fetch(`/api/v1/tickets/${id}/close`, { method: 'PUT', credentials: 'include' });
        load();
      };
    }

    ['tkt-search', 'tkt-dept', 'tkt-status'].forEach(id => {
      document.getElementById(id)!.addEventListener('input', renderList);
      document.getElementById(id)!.addEventListener('change', renderList);
    });

    async function load() {
      try {
        const res = await fetch('/api/v1/admin/tickets', { credentials: 'include' });
        const json = await res.json();
        allTickets = json.data?.tickets || [];
        renderList();
      } catch {
        document.getElementById('ticket-list')!.innerHTML = '<p class="text-coral text-sm p-4">Failed to load.</p>';
      }
    }
    load();
  </script>
</AdminLayout>
