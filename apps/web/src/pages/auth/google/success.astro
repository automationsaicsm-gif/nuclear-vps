---
// This page is the OAuth redirect target after Google login.
// It calls /me to get the user, stores in localStorage, then redirects.
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Signing in… — Nuclear VPS</title>
  <style>
    body { background: #0F0D1A; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; font-family: Arial, sans-serif; }
    .spinner { width: 48px; height: 48px; border: 4px solid #E5E7EB; border-top-color: #2D55C8; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    p { color: #374151; margin-top: 16px; font-size: 14px; }
    div { text-align: center; }
  </style>
</head>
<body>
  <div>
    <div class="spinner"></div>
    <p>Completing sign-in…</p>
  </div>
  <script>
    (async () => {
      try {
        const res = await fetch('/api/v1/auth/me', { credentials: 'include' });
        if (!res.ok) throw new Error('auth failed');
        const json = await res.json();
        const user = json.data;
        localStorage.setItem('nuclear-vps-auth', JSON.stringify({ state: { user } }));
        window.location.replace(user.role === 'ADMIN' ? '/admin' : '/dashboard');
      } catch {
        window.location.replace('/login?error=google_failed');
      }
    })();
  </script>
</body>
</html>
