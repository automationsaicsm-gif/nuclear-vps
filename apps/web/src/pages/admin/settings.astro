---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Settings — Nuclear VPS">

  <div class="max-w-3xl space-y-8">

    <!-- General Settings -->
    <div class="card p-6">
      <h2 class="font-heading font-black text-text-h text-lg mb-6">General Settings</h2>
      <div id="settings-error" class="hidden mb-4 bg-coral/10 border border-coral/30 rounded-xl p-3 text-coral text-sm"></div>
      <div id="settings-success" class="hidden mb-4 bg-green-500/10 border border-green-500/30 rounded-xl p-3 text-green-400 text-sm"></div>
      <form id="settings-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Site Name</label>
            <input id="s-sitename" name="site_name" type="text"
              class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors text-sm" />
          </div>
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Contact Email</label>
            <input id="s-email" name="contact_email" type="email"
              class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors text-sm" />
          </div>
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Site URL</label>
            <input id="s-url" name="site_url" type="url"
              class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors text-sm" />
          </div>
          <div>
            <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">Maintenance Mode</label>
            <div class="flex items-center gap-3 h-12">
              <label class="relative inline-flex items-center cursor-pointer">
                <input id="s-maintenance" name="maintenance_mode" type="checkbox" class="sr-only peer" />
                <div class="w-11 h-6 bg-surface border border-[#312E81] rounded-full peer peer-checked:bg-coral transition-colors"></div>
                <div class="absolute left-1 top-1 w-4 h-4 bg-text-muted rounded-full transition-transform peer-checked:translate-x-5 peer-checked:bg-white"></div>
              </label>
              <span class="text-text-body text-sm">Enable maintenance mode</span>
            </div>
          </div>
        </div>
        <button type="submit" class="btn-primary text-sm px-8 py-2.5">Save Settings</button>
      </form>
    </div>

    <!-- SMTP Settings -->
    <div class="card p-6">
      <h2 class="font-heading font-black text-text-h text-lg mb-6">SMTP / Email Settings</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">SMTP Host</label>
          <input id="s-smtp-host" name="smtp_host" type="text" placeholder="smtp.gmail.com"
            class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors text-sm" />
        </div>
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">SMTP Port</label>
          <input id="s-smtp-port" name="smtp_port" type="number" placeholder="587"
            class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors text-sm" />
        </div>
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">SMTP Username</label>
          <input id="s-smtp-user" name="smtp_user" type="text"
            class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors text-sm" />
        </div>
        <div>
          <label class="block text-text-muted text-xs font-heading font-black uppercase tracking-wide mb-2">SMTP Password</label>
          <input id="s-smtp-pass" name="smtp_pass" type="password" placeholder="••••••••"
            class="w-full bg-base border border-[#312E81] rounded-xl px-4 py-3 text-text-h focus:outline-none focus:border-coral transition-colors text-sm" />
        </div>
      </div>
      <div class="flex gap-3">
        <button id="save-smtp" class="btn-primary text-sm px-6 py-2.5">Save SMTP</button>
        <button id="test-email-btn" class="btn-ghost text-sm px-6 py-2.5">Send Test Email</button>
      </div>
      <p id="test-email-result" class="text-sm mt-3 hidden"></p>
    </div>

    <!-- Payment Keys (masked) -->
    <div class="card p-6">
      <h2 class="font-heading font-black text-text-h text-lg mb-2">Payment Gateway Keys</h2>
      <p class="text-text-muted text-sm mb-6">These are configured via environment variables. Shown here for reference only.</p>
      <div class="space-y-3">
        {[
          { label: 'Stripe Secret Key', key: 'STRIPE_SECRET_KEY' },
          { label: 'Stripe Publishable Key', key: 'NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY' },
          { label: 'PayPal Client ID', key: 'PAYPAL_CLIENT_ID' },
          { label: 'Coinbase API Key', key: 'COINBASE_API_KEY' },
        ].map(({ label, key }) => (
          <div class="flex items-center justify-between py-3 border-b border-[#312E81] last:border-0">
            <p class="text-text-body text-sm font-heading font-bold">{label}</p>
            <span class="font-mono text-text-muted text-xs bg-deep px-3 py-1.5 rounded-lg">{key}=***</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script>
    async function loadSettings() {
      try {
        const res = await fetch('/api/v1/admin/settings', { credentials: 'include' });
        const json = await res.json();
        const settings: Record<string, string> = {};
        (json.data?.settings || []).forEach((s: any) => { settings[s.key] = s.value; });

        (document.getElementById('s-sitename') as HTMLInputElement).value = settings.site_name || 'Nuclear VPS';
        (document.getElementById('s-email') as HTMLInputElement).value = settings.contact_email || '';
        (document.getElementById('s-url') as HTMLInputElement).value = settings.site_url || '';
        (document.getElementById('s-maintenance') as HTMLInputElement).checked = settings.maintenance_mode === 'true';
        (document.getElementById('s-smtp-host') as HTMLInputElement).value = settings.smtp_host || '';
        (document.getElementById('s-smtp-port') as HTMLInputElement).value = settings.smtp_port || '587';
        (document.getElementById('s-smtp-user') as HTMLInputElement).value = settings.smtp_user || '';
      } catch {}
    }

    document.getElementById('settings-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errEl = document.getElementById('settings-error')!;
      const sucEl = document.getElementById('settings-success')!;
      errEl.classList.add('hidden');
      sucEl.classList.add('hidden');
      const form = e.target as HTMLFormElement;
      const data = Object.fromEntries(new FormData(form));
      const settings: any[] = [
        { key: 'site_name', value: data.site_name },
        { key: 'contact_email', value: data.contact_email },
        { key: 'site_url', value: data.site_url },
        { key: 'maintenance_mode', value: String((document.getElementById('s-maintenance') as HTMLInputElement).checked) },
      ];
      try {
        const res = await fetch('/api/v1/admin/settings', {
          method: 'PUT', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ settings }),
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error);
        sucEl.textContent = 'Settings saved.';
        sucEl.classList.remove('hidden');
      } catch (err: any) {
        errEl.textContent = err.message;
        errEl.classList.remove('hidden');
      }
    });

    document.getElementById('save-smtp')!.addEventListener('click', async () => {
      const settings = [
        { key: 'smtp_host', value: (document.getElementById('s-smtp-host') as HTMLInputElement).value },
        { key: 'smtp_port', value: (document.getElementById('s-smtp-port') as HTMLInputElement).value },
        { key: 'smtp_user', value: (document.getElementById('s-smtp-user') as HTMLInputElement).value },
      ];
      await fetch('/api/v1/admin/settings', {
        method: 'PUT', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ settings }),
      });
    });

    document.getElementById('test-email-btn')!.addEventListener('click', async () => {
      const el = document.getElementById('test-email-result')!;
      el.textContent = 'Sending...';
      el.className = 'text-sm mt-3 text-text-muted';
      el.classList.remove('hidden');
      try {
        const res = await fetch('/api/v1/admin/settings/test-email', { method: 'POST', credentials: 'include' });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error);
        el.textContent = 'Test email sent successfully!';
        el.className = 'text-sm mt-3 text-green-400';
      } catch (err: any) {
        el.textContent = `Failed: ${err.message}`;
        el.className = 'text-sm mt-3 text-coral';
      }
    });

    loadSettings();
  </script>
</AdminLayout>
